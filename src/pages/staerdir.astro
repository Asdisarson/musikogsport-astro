---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getWpPageBySlug } from '../lib/wp';

export const prerender = false;

// Long-form, non-fact-sensitive content — pulled live from WP so staff keep editing it there.
const page = await getWpPageBySlug('staerdir');
---

<Base
  title="Stærðartafla"
  description="Stærðartöflur fyrir fatnað og skó frá Músík og Sport — finndu réttu stærðina áður en þú pantar."
>
  <div class="container container--wide">
    <Breadcrumbs items={[{ label: 'Forsíða', href: '/' }, { label: 'Stærðartafla' }]} />
    <div class="page-head">
      <p class="eyebrow">Upplýsingar</p>
      <h1>Stærðartafla</h1>
      <p>Berðu saman mál og finndu réttu stærðina áður en þú pantar — það fækkar skilum og skiptum.</p>
    </div>
  </div>
  <section class="section--tight container container--wide">
    {
      page ? (
        <div class="prose prose--wide" set:html={page.html} />
      ) : (
        <p class="muted">
          Stærðartaflan er ekki aðgengileg í augnablikinu. Hafðu samband í síma{' '}
          <a href="tel:+3545552887">555 2887</a> og við aðstoðum þig við að velja rétta stærð.
        </p>
      )
    }
  </section>
</Base>
