---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CheckoutForm from '../components/CheckoutForm.tsx';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store'); // checkout reflects the live cart — never cache
---

<Base title="Greiðsla" noindex>
  <div class="container container--wide">
    <Breadcrumbs items={[{ label: 'Forsíða', href: '/' }, { label: 'Karfa', href: '/karfa' }, { label: 'Greiðsla' }]} />
    <div class="page-head">
      <p class="eyebrow">Ganga frá pöntun</p>
      <h1>Greiðsla</h1>
    </div>
    <CheckoutForm client:load />
  </div>
</Base>
