---
import Base from '../../layouts/Base.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import SortFilterBar from '../../components/SortFilterBar.astro';
import Pagination from '../../components/Pagination.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { listProducts } from '../../lib/woo';
import { parseSort, pageHref } from '../../lib/query';
import { ld, breadcrumbList } from '../../lib/jsonld';
import type { Paged, WooProduct } from '../../lib/types';

export const prerender = false;

const params = Astro.url.searchParams;
const page = Math.max(1, Number(params.get('page')) || 1);
const sort = params.get('sort') ?? 'date';
const onSale = params.get('on_sale') === 'true';
const inStock = params.get('instock') === 'true';
const { orderby, order } = parseSort(sort);

const empty: Paged<WooProduct> = { items: [], total: 0, totalPages: 0, page };
const result = await listProducts({
  page,
  per_page: 24,
  orderby,
  order,
  on_sale: onSale || undefined,
  stock_status: inStock ? 'instock' : undefined,
}).catch(() => empty);

const baseParams = new URLSearchParams(params);
baseParams.delete('page');
const hrefFor = (n: number) => pageHref('/verslun', baseParams, n);

const crumbs = [{ label: 'Forsíða', href: '/' }, { label: 'Verslun' }];
const siteHref = Astro.site?.href ?? 'https://musikogsport.is/';
const breadcrumbLdObj = breadcrumbList(crumbs, siteHref, new URL('/verslun', siteHref).href);
---

<Base title="Verslun" description="Allar vörur í vefverslun Músík og Sport.">
  <script type="application/ld+json" is:inline slot="head" set:html={ld(breadcrumbLdObj)} />
  <div class="container container--wide">
    <Breadcrumbs items={crumbs} />
    <div class="page-head">
      <p class="eyebrow">Vefverslun</p>
      <h1>Allar vörur</h1>
      <p>Hlaupaskór, fatnaður, útivist, æfingavörur og félagabúningar frá fremstu vörumerkjum.</p>
    </div>
  </div>
  <SortFilterBar total={result.total} sort={sort} onSale={onSale} inStock={inStock} />
  <div class="section--tight container container--wide">
    <ProductGrid products={result.items} eagerCount={4} />
  </div>
  <div class="container container--wide">
    <Pagination page={result.page} totalPages={result.totalPages} hrefFor={hrefFor} />
  </div>
</Base>
