---
import Base from '../../layouts/Base.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import SortFilterBar from '../../components/SortFilterBar.astro';
import Pagination from '../../components/Pagination.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import NotFound from '../../components/NotFound.astro';
import { getCategoryBySlug, listProducts } from '../../lib/woo';
import { decodeEntities } from '../../lib/decode';
import { sanitizeHtml } from '../../lib/sanitize';
import { parseSort, pageHref } from '../../lib/query';
import { ld, breadcrumbList } from '../../lib/jsonld';
import type { Paged, WooProduct } from '../../lib/types';

export const prerender = false;

const slug = Astro.params.category ?? '';
const cat = slug ? await getCategoryBySlug(slug).catch(() => null) : null;

if (!cat) {
  Astro.response.status = 404;
}

const params = Astro.url.searchParams;
const page = Math.max(1, Number(params.get('page')) || 1);
const sort = params.get('sort') ?? 'date';
const onSale = params.get('on_sale') === 'true';
const inStock = params.get('instock') === 'true';
const { orderby, order } = parseSort(sort);

const empty: Paged<WooProduct> = { items: [], total: 0, totalPages: 0, page };
const result = cat
  ? await listProducts({
      category: cat.id,
      page,
      per_page: 24,
      orderby,
      order,
      on_sale: onSale || undefined,
      stock_status: inStock ? 'instock' : undefined,
    }).catch(() => empty)
  : empty;

const baseParams = new URLSearchParams(params);
baseParams.delete('page');
const hrefFor = (n: number) => pageHref(`/verslun/${slug}`, baseParams, n);
const name = cat ? decodeEntities(cat.name) : '';

const crumbs = [
  { label: 'Forsíða', href: '/' },
  { label: 'Verslun', href: '/verslun' },
  { label: name },
];
const siteHref = Astro.site?.href ?? 'https://musikogsport.is/';
const canonicalUrl = new URL(Astro.url.pathname, siteHref).href;
const breadcrumbLdObj = cat ? breadcrumbList(crumbs, siteHref, canonicalUrl) : null;
---

{
  cat ? (
    <Base title={name} description={`${name} — vörur í vefverslun Músík og Sport.`}>
      {breadcrumbLdObj && <script type="application/ld+json" is:inline slot="head" set:html={ld(breadcrumbLdObj)} />}
      <div class="container container--wide">
        <Breadcrumbs items={crumbs} />
        <div class="page-head">
          <p class="eyebrow">Flokkur</p>
          <h1>{name}</h1>
          {cat.description && <p set:html={sanitizeHtml(cat.description)} />}
        </div>
      </div>
      <SortFilterBar total={result.total} sort={sort} onSale={onSale} inStock={inStock} />
      <div class="section--tight container container--wide">
        <ProductGrid products={result.items} eagerCount={4} />
      </div>
      <div class="container container--wide">
        <Pagination page={result.page} totalPages={result.totalPages} hrefFor={hrefFor} />
      </div>
    </Base>
  ) : (
    <Base title="Flokkur fannst ekki">
      <NotFound title="Flokkur fannst ekki" message="Þessi vöruflokkur er ekki til." />
    </Base>
  )
}
