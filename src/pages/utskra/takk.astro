---
import Base from '../../layouts/Base.astro';

export const prerender = false;

const order = Astro.url.searchParams.get('order') ?? Astro.url.searchParams.get('order_id') ?? '';
---

<Base title="Takk fyrir pöntunina">
  <div class="container confirm">
    <p class="confirm__check">✓</p>
    <h1>Takk fyrir pöntunina!</h1>
    {order && <p>Pöntunarnúmer: <strong>{order}</strong></p>}
    <p class="muted">Við höfum tekið við pöntun þinni. Staðfesting og greiðsluupplýsingar verða sendar í tölvupósti.</p>
    <div class="bank-box">
      <strong>Bankamillifærsla</strong>
      <p class="muted" style="margin:0.5rem 0 0;">
        Vinsamlegast greiddu fyrir pöntuninni með millifærslu samkvæmt upplýsingum í staðfestingarpóstinum.
        Pöntunin er afgreidd um leið og greiðsla hefur borist.
      </p>
    </div>
    <a class="btn btn--primary" href="/verslun">Halda áfram að versla</a>
  </div>
</Base>
