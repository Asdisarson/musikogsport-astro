---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { readOrderCookie, clearOrderCookie } from '../../lib/cartProxy';
import { getOrder, type OrderSummary } from '../../lib/woo';

export const prerender = false;

// Resolve order identity: URL params first (the headless-bridge appends order_id +
// order_key on the gateway return), then the httpOnly cookie set at checkout
// (refresh/bookmark fallback). Then fetch a non-PII order summary, key-gated.
const params = Astro.url.searchParams;
let orderId = Number(params.get('order_id'));
let orderKey = params.get('order_key') ?? '';
if (!orderId || !orderKey) {
  const cookie = readOrderCookie(Astro);
  if (cookie) {
    if (!orderId) orderId = cookie.id;
    if (!orderKey) orderKey = cookie.key;
  }
}

let order: OrderSummary | null = null;
if (Number.isInteger(orderId) && orderId > 0 && orderKey) {
  order = await getOrder(orderId, orderKey).catch(() => null);
}
// One-shot: drop the fallback cookie so a later bare visit can't resurface a stale order.
clearOrderCookie(Astro);

// Render STRICTLY from a positively-resolved order. Never infer a gateway — or echo a
// caller-supplied id — from an unresolved/failed lookup; an unknown order falls to
// neutral copy (no bank-transfer box, no fabricated order number).
const isCard = order?.payment_method === 'straumur';
const isBank = order?.payment_method === 'bacs';
const paid = order?.paid ?? false;
const displayNumber = order?.order_number ?? '';

// Poll for the pending→paid flip only for an unconfirmed card payment. NB: on Local
// this stays pending (the confirmation webhook can't reach the site) — that is the
// EXPECTED state here, not a bug.
const showPoll = isCard && !paid;

const cardPaidCopy = 'Greiðslan þín hefur verið staðfest. Staðfesting hefur verið send í tölvupósti.';
const cardPendingCopy =
  'Við höfum tekið við greiðslunni. Staðfesting berst á næstu mínútum og pöntunin fer þá í vinnslu — þú færð staðfestingu í tölvupósti.';
const neutralCopy = 'Við höfum tekið við pöntun þinni. Staðfesting og greiðsluupplýsingar verða sendar í tölvupósti.';
---

<Base title="Takk fyrir pöntunina" noindex>
  <div class="container confirm">
    <div class="confirm__check"><Icon name="check" size={32} stroke-width={2.2} /></div>
    <p class="eyebrow eyebrow--plain" style="justify-content:center;color:var(--accent)">Pöntun móttekin</p>
    <h1>Takk fyrir pöntunina!</h1>
    {displayNumber && <p class="lead">Pöntunarnúmer: <strong>{displayNumber}</strong></p>}

    {isCard && (
      <p class="order-status" id="order-status" data-state={paid ? 'paid' : 'pending'}>
        {paid ? 'Greiðsla staðfest' : 'Staðfesting í vinnslu…'}
      </p>
    )}

    <p class="muted" id="order-copy">
      {isCard ? (paid ? cardPaidCopy : cardPendingCopy) : neutralCopy}
    </p>

    {isBank && (
      <div class="bank-box">
        <strong>Bankamillifærsla</strong>
        <p class="muted" style="margin:0.6rem 0 0;">
          Vinsamlegast greiddu fyrir pöntuninni með millifærslu samkvæmt upplýsingum í
          staðfestingarpóstinum. Pöntunin er afgreidd um leið og greiðsla hefur borist.
        </p>
      </div>
    )}

    <div class="cluster" style="justify-content:center">
      <a class="btn btn--primary" href="/verslun">Halda áfram að versla <Icon name="arrow-right" size={18} /></a>
      <a class="btn btn--ghost" href="/">Forsíða</a>
    </div>
  </div>

  {showPoll && (
    <script is:inline define:vars={{ orderId, orderKey, cardPaidCopy }}>
      (function () {
        const pill = document.getElementById('order-status');
        const copy = document.getElementById('order-copy');
        if (!pill) return;
        const MAX = 8;
        let tries = 0;
        const tick = async () => {
          tries++;
          try {
            const res = await fetch(
              `/api/order?id=${orderId}&key=${encodeURIComponent(orderKey)}`,
              { headers: { Accept: 'application/json' } },
            );
            if (res.ok) {
              const o = await res.json();
              if (o && o.paid) {
                pill.textContent = 'Greiðsla staðfest';
                pill.dataset.state = 'paid';
                if (copy) copy.textContent = cardPaidCopy;
                return; // confirmed — stop polling
              }
            }
          } catch (_) {
            /* transient — keep trying until the cap */
          }
          if (tries < MAX) setTimeout(tick, 3000);
        };
        setTimeout(tick, 3000);
      })();
    </script>
  )}
</Base>

<style>
  .order-status {
    display: inline-block;
    margin: 0 auto 0.5rem;
    font-weight: 700;
    font-size: var(--fz-sm);
    padding: 0.35rem 0.85rem;
    border-radius: var(--r-pill);
  }
  .order-status[data-state='paid'] {
    background: color-mix(in srgb, var(--good) 16%, var(--surface));
    color: var(--good);
  }
  .order-status[data-state='pending'] {
    background: var(--surface);
    color: var(--muted);
    border: 1px solid var(--line-strong);
  }
</style>
