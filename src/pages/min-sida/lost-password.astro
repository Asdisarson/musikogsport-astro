---
import Base from '../../layouts/Base.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

// WooCommerce's lost-password endpoint. Without key/id: the request form. With them (the link in
// WooCommerce's reset email): the new-password form.
const q = Astro.url.searchParams;
const key = q.get('key') ?? '';
const id = q.get('id') ?? '';
const resetting = Boolean(key && /^\d+$/.test(id));
const errors: Record<string, string> = {
  empty: 'Sláðu inn notendanafn eða netfang.',
  limited: 'Of margar beiðnir. Reyndu aftur síðar.',
  unavailable: 'Þjónustan svaraði ekki. Prófaðu að skrá þig inn með nýja lykilorðinu; ef það gengur ekki, reyndu aftur hér.',
  notsaved: 'Nýja lykilorðið var ekki vistað: þjónustan er tímabundið óaðgengileg. Reyndu aftur eftir smá stund.',
  invalid: 'Þessi tengill er ógildur eða útrunninn. Biddu um nýjan hér fyrir neðan.',
  short: 'Lykilorðið þarf að vera að minnsta kosti 8 stafir.',
  long: 'Lykilorðið má mest vera 200 stafir.',
  mismatch: 'Lykilorðin eru ekki eins.',
};
const error = q.get('error');
const sent = q.get('sent') === '1';
---

<Base title="Týnt lykilorð" noindex>
  <div class="login-wrap">
    <h1 class="login-wrap__title">Mín Síða</h1>
    {error && <p class="woo-notice woo-notice--error" role="alert">{errors[error] ?? errors.invalid}</p>}
    {
      sent ? (
        <div class="login-box">
          <p class="woo-notice woo-notice--success" role="status">Tölvupóstur fyrir endurstillingu lykilorðs hefur verið sendur.</p>
          <p>
            Tölvupóstur fyrir endurstillingu lykilorðs hefur verið sendur á netfangið sem skráð er á aðganginn þinn, en það getur tekið nokkrar
            mínútur að birtast í pósthólfinu þínu. Vinsamlegast bíddu að minnsta kosti 10 mínútur áður en þú reynir aftur.
          </p>
        </div>
      ) : resetting ? (
        <form class="login-box login-form account-fields" method="post" action="/api/account/reset-password">
          <p>Sláðu inn nýtt lykilorð hér fyrir neðan.</p>
          <input type="hidden" name="key" value={key} />
          <input type="hidden" name="id" value={id} />
          <p class="form-row form-row-wide">
            <input class="input-text" id="password_1" name="password_1" type="password" placeholder=" " autocomplete="new-password" aria-required="true" />
            <label for="password_1">Nýtt lykilorð <abbr class="required" title="nauðsynlegt">*</abbr></label>
          </p>
          <p class="form-row form-row-wide">
            <input class="input-text" id="password_2" name="password_2" type="password" placeholder=" " autocomplete="new-password" aria-required="true" />
            <label for="password_2">Endurtaktu nýja lykilorðið <abbr class="required" title="nauðsynlegt">*</abbr></label>
          </p>
          <button class="btn-dark btn-block" type="submit">Vista</button>
        </form>
      ) : (
        <form class="login-box login-form account-fields" method="post" action="/api/account/lost-password">
          <p>
            Týndirðu lykilorðinu? Vinsamlegast sláðu inn notendanafnið þitt eða netfang. Þú munt fá tengil í tölvupósti til að búa til nýtt
            lykilorð.
          </p>
          <p class="form-row form-row-wide">
            <input class="input-text" id="user_login" name="user_login" placeholder=" " autocomplete="username" aria-required="true" />
            <label for="user_login">Notendanafn eða netfang <abbr class="required" title="nauðsynlegt">*</abbr></label>
          </p>
          <button class="btn-dark btn-block" type="submit">Endurstilla lykilorð</button>
        </form>
      )
    }
  </div>
</Base>
