---
import AccountLayout from '../../components/AccountLayout.astro';
import { currentUser } from '../../lib/auth';
import { loadCustomer, UNAVAILABLE_TEXT } from '../../lib/account';
import { markUnavailable } from '../../lib/http';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

// WooCommerce's "Aðgangsupplýsingar": name, email, and a password change behind the current password.
const user = await currentUser(Astro.cookies);
if (!user) return Astro.redirect('/min-sida/');
const loaded = await loadCustomer(user.id);
// WooCommerce down: no form (blank fields a customer could submit), a 503 with the outage notice instead.
const down = loaded === 'unavailable';
if (down) markUnavailable(Astro.response);
const customer = down ? null : loaded;
const q = Astro.url.searchParams;
const errors: Record<string, string> = {
  required: 'Vinsamlegast fylltu út nafn og netfang.',
  email: 'Ógilt netfang.',
  password_fields: 'Fylltu út bæði núverandi og nýtt lykilorð.',
  short: 'Nýja lykilorðið þarf að vera að minnsta kosti 8 stafir.',
  long: 'Lykilorðið má mest vera 200 stafir.',
  mismatch: 'Nýju lykilorðin eru ekki eins.',
  current: 'Núverandi lykilorð er rangt.',
  limited: 'Of margar tilraunir. Reyndu aftur síðar.',
  maybe: 'Ekki fékkst staðfesting á vistuninni. Ef þú verður skráð(ur) út skaltu skrá þig inn með nýja lykilorðinu.',
  unavailable: 'Ekki tókst að staðfesta lykilorðið: þjónustan svaraði ekki. Reyndu aftur eftir smá stund.',
  save: 'Ekki tókst að vista breytingarnar. Reyndu aftur.',
};
const error = q.get('error');
const notice = down
  ? { kind: 'error' as const, text: UNAVAILABLE_TEXT }
  : q.get('saved') === '1'
  ? { kind: 'success' as const, text: 'Aðgangsupplýsingum breytt.' }
  : error
    ? { kind: 'error' as const, text: errors[error] ?? errors.save }
    : null;
---

<AccountLayout title="Aðgangsupplýsingar" current="edit-account" notice={notice}>
  {!down && (
  <form class="account-form account-fields" method="post" action="/api/account/details">
    <p class="form-row form-row-first">
      <input class="input-text" id="account_first_name" name="account_first_name" value={customer?.first_name ?? ''} placeholder=" " autocomplete="given-name" aria-required="true" />
      <label for="account_first_name">Eiginnafn <abbr class="required" title="nauðsynlegt">*</abbr></label>
    </p>
    <p class="form-row form-row-last">
      <input class="input-text" id="account_last_name" name="account_last_name" value={customer?.last_name ?? ''} placeholder=" " autocomplete="family-name" aria-required="true" />
      <label for="account_last_name">Eftirnafn <abbr class="required" title="nauðsynlegt">*</abbr></label>
    </p>
    <p class="form-row form-row-wide">
      <input class="input-text" id="account_email" name="account_email" type="email" value={customer?.email ?? user.email} placeholder=" " autocomplete="email" aria-required="true" />
      <label for="account_email">Netfang <abbr class="required" title="nauðsynlegt">*</abbr></label>
    </p>
    <fieldset class="account-form__password">
      <legend>Breyta lykilorði</legend>
      <p class="form-row form-row-wide">
        <input class="input-text" id="password_current" name="password_current" type="password" placeholder=" " autocomplete="current-password" />
        <label for="password_current">Núverandi lykilorð (skildu eftir autt til að halda því óbreyttu)</label>
      </p>
      <p class="form-row form-row-wide">
        <input class="input-text" id="password_1" name="password_1" type="password" placeholder=" " autocomplete="new-password" />
        <label for="password_1">Nýtt lykilorð (skildu eftir autt til að halda því óbreyttu)</label>
      </p>
      <p class="form-row form-row-wide">
        <input class="input-text" id="password_2" name="password_2" type="password" placeholder=" " autocomplete="new-password" />
        <label for="password_2">Staðfesta nýtt lykilorð</label>
      </p>
    </fieldset>
    <button class="btn-dark" type="submit">Vista breytingar</button>
  </form>
  )}
</AccountLayout>
