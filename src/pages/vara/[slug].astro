---
// Legacy app-astro product URL → 301 to live's /verslun/<category path>/<slug>/.
import Base from '../../layouts/Base.astro';
import NotFound from '../../components/NotFound.astro';
import { getProductBySlug } from '../../lib/woo';
import { productPath } from '../../lib/paths';
import { markUnavailable } from '../../lib/http';

export const prerender = false;

const slug = Astro.params.slug ?? '';
// A failed lookup is an outage (a missing slug is an empty list), so it answers 503, not 404.
let down = false;
const product = slug
  ? await getProductBySlug(slug).catch(() => {
      down = true;
      return null;
    })
  : null;
const redirectTo = product ? productPath(product.permalink, product.slug) : null;
if (redirectTo) return Astro.redirect(redirectTo, 301);
if (down) markUnavailable(Astro.response);
else Astro.response.status = 404;
---

<Base title={down ? 'Tímabundin bilun' : 'Vara fannst ekki'}>
  <NotFound unavailable={down} title="Vara fannst ekki" message="Þessi vara er ekki til eða hefur verið fjarlægð." />
</Base>
