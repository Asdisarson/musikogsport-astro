---
import Base from '../layouts/Base.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductImage from '../components/ProductImage.astro';
import { listProducts, listTopCategories } from '../lib/woo';
import { productImage } from '../lib/img';
import { decodeEntities } from '../lib/decode';
import type { Paged, WooProduct } from '../lib/types';

const EMPTY: Paged<WooProduct> = { items: [], total: 0, totalPages: 0, page: 1 };

const [topCats, newest, popular, onSale] = await Promise.all([
  listTopCategories().catch(() => []),
  listProducts({ orderby: 'date', per_page: 10 }).catch(() => EMPTY),
  listProducts({ orderby: 'popularity', per_page: 10 }).catch(() => EMPTY),
  listProducts({ on_sale: true, per_page: 5, orderby: 'popularity' }).catch(() => EMPTY),
]);

const heroProducts = newest.items.slice(0, 4);
const tiles = topCats.slice(0, 8);
---

<Base description="Hljóðfæri, hljómtækni og íþróttavörur frá fagfólki. Yfir 30 ára reynsla, vönduð vörumerki og persónuleg þjónusta.">
  <section class="hero">
    <div class="hero__inner">
      <div>
        <p class="eyebrow">Vor 2026</p>
        <h1>Hljóðfæri og íþróttavörur frá fagfólki</h1>
        <p>Yfir 30 ára reynsla. Vönduð vörumerki. Persónuleg þjónusta.</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="/verslun">Skoða allar vörur</a>
          <a class="btn" href="/verslun/sale">Útsala</a>
        </div>
      </div>
      <div class="hero__media">
        {
          heroProducts.map((p) => {
            const img = productImage(p);
            return (
              <a href={`/vara/${p.slug}`} aria-label={decodeEntities(p.name)}>
                <ProductImage src={img.src} alt={img.alt} loading="eager" />
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  {
    tiles.length > 0 && (
      <section class="section container">
        <div class="section__head">
          <div>
            <p class="eyebrow">Flokkar</p>
            <h2>Verslaðu eftir flokki</h2>
          </div>
        </div>
        <ul class="tiles">
          {tiles.map((c) => (
            <li>
              <a class="tile" href={`/verslun/${c.slug}`}>
                {decodeEntities(c.name)}
                <small>{c.count.toLocaleString('is-IS')} vörur</small>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section container">
    <div class="section__head">
      <div>
        <p class="eyebrow">Nýtt í verslun</p>
        <h2>Nýjustu vörurnar</h2>
      </div>
      <a href="/verslun?sort=date">Sjá allt</a>
    </div>
    <ProductGrid products={newest.items} />
  </section>

  {
    onSale.items.length > 0 && (
      <section class="section container">
        <div class="section__head">
          <div>
            <p class="eyebrow">Tilboð</p>
            <h2>Á útsölu núna</h2>
          </div>
          <a href="/verslun/sale">Sjá allt</a>
        </div>
        <ProductGrid products={onSale.items} />
      </section>
    )
  }

  <section class="section container">
    <div class="section__head">
      <div>
        <p class="eyebrow">Vinsælast</p>
        <h2>Það sem aðrir eru að skoða</h2>
      </div>
      <a href="/verslun?sort=popularity">Sjá allt</a>
    </div>
    <ProductGrid products={popular.items} />
  </section>
</Base>
