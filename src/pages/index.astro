---
// WordPress-style product search lives on the home URL (/?s=<q>&post_type=product, as on live).
// An empty search goes to the shop (302: the query, not the page, decides it).
import { homeSearch } from '../lib/paths';
const search = homeSearch(Astro.url.search);
if (search) return 'rewrite' in search ? Astro.rewrite(search.rewrite) : Astro.redirect(search.redirect, 302);
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import ProductRow from '../components/ProductRow.astro';
import BannerRow from '../components/BannerRow.astro';
import { loadFrontPage, type ProductRowConfig } from '../lib/frontPage';
import { homeSections, planHome } from '../lib/homeLayout';
import { storeProducts, type StoreQuery } from '../lib/storeCatalog';
import type { WooProduct } from '../lib/types';
import { markUnavailable } from '../lib/http';

// The home page (nike-look), all WordPress "Forsíða" data: a full-bleed hero (first banner image, hero
// heading/text/button), then product-tile carousels alternating with story-tile rows from the other banners.
const front = await loadFrontPage();
if (!front) markUnavailable(Astro.response); // never loaded: the page below is an empty shell

function rowQuery(row: ProductRowConfig): StoreQuery {
  switch (row.source) {
    case 'popular':
      return { orderby: 'popularity', order: 'desc' };
    case 'on_sale':
      return { on_sale: true, orderby: 'date', order: 'desc' };
    case 'category':
      return row.category ? { categoryIds: [row.category.id], orderby: 'date', order: 'desc' } : { orderby: 'date', order: 'desc' };
    default:
      return { orderby: 'date', order: 'desc' };
  }
}

const rowConfigs = front?.rows ?? [];
const rowProducts: WooProduct[][] = await Promise.all(
  rowConfigs.map((r) => storeProducts({ ...rowQuery(r), page: 1, per_page: r.count }).then((p) => p.items).catch(() => [])),
);
const plan = planHome(front?.hero, front?.banners ?? []);
const sections = homeSections(rowConfigs.length, plan.stories);
---

<Base>
  <div class="home">
    {plan.hero && <HeroSlider plan={plan.hero} />}
    {
      sections.map((s) =>
        s.kind === 'row' ? (
          <ProductRow title={rowConfigs[s.index].title} products={rowProducts[s.index] ?? []} />
        ) : (
          <BannerRow banners={s.banners} />
        ),
      )
    }
  </div>
</Base>
