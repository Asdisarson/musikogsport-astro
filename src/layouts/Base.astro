---
import '../styles/global.css';
import CampaignBar from '../components/CampaignBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SideMenu from '../components/SideMenu.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import StoreNotice from '../components/StoreNotice.astro';
import CartDrawer from '../components/CartDrawer.tsx';
import LoginPopup from '../components/LoginPopup.astro';
import Icon from '../components/Icon.astro';
import { loadSiteChrome } from '../lib/siteChrome';
import { ld } from '../lib/jsonld';

interface Props {
  title?: string;
  description?: string;
  /** Absolute (or root-relative) image URL for og:image / twitter:image. */
  image?: string;
  /** Open Graph type — 'website' (default) or 'product' on PDPs. */
  ogType?: string;
  /** Emit a noindex robots meta (cart/checkout/transient pages). */
  noindex?: boolean;
  /** Live's distraction-free checkout: logo only — no utility bar, menu, footer or side cart. */
  distractionFree?: boolean;
  /** Archive pagination (lib/paths pageLinks): <link rel="prev"> / <link rel="next"> as on live. */
  pageLinks?: { prev: string | null; next: string | null };
}
const { title, description, image, ogType = 'website', noindex = false, distractionFree = false, pageLinks } = Astro.props;
// Live's <title> pattern: "Page | Músik & Sport".
const fullTitle = title ? `${title} | Músik & Sport` : 'Músík og Sport | Músik & Sport';
const desc =
  description ??
  'Íþróttavörur, hlaupaskór, fatnaður og útivist frá fagfólki. Yfir 30 ára reynsla, vönduð vörumerki og persónuleg þjónusta.';

const chrome = await loadSiteChrome();
const headerLogo = chrome.logos.header ?? { url: '/logo-header.webp', width: 262, height: 80, alt: 'Músík og Sport' };
const miniCartBar = chrome.shippingBar?.locations.includes('minicart') ? chrome.shippingBar : null;

// Absolute URLs for canonical + social tags (Astro.site = https://musikogsport.is).
const siteUrl = Astro.site?.href ?? 'https://musikogsport.is/';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image ? new URL(image, siteUrl).href : undefined;

// Site-wide structured data (identical on every page).
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Músík og Sport ehf.',
  url: siteUrl,
  logo: new URL('/logo-header.webp', siteUrl).href,
  email: chrome.footer.email,
  telephone: '+354 555 2887',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Dalshraun 10',
    postalCode: '220',
    addressLocality: 'Hafnarfjörður',
    addressCountry: 'IS',
  },
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Músík og Sport',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}?s={search_term_string}&post_type=product`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="is">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    {pageLinks?.prev && <link rel="prev" href={new URL(pageLinks.prev, siteUrl).href} />}
    {pageLinks?.next && <link rel="next" href={new URL(pageLinks.next, siteUrl).href} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Músík og Sport" />
    <meta property="og:locale" content="is_IS" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Site-wide structured data -->
    <script type="application/ld+json" is:inline set:html={ld(orgLd)} />
    <script type="application/ld+json" is:inline set:html={ld(websiteLd)} />

    <!-- Before first paint: mark JS available and hide messages the visitor already dismissed. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const d = JSON.parse(localStorage.getItem('mos-dismissed') || '{}');
          if (d.notice) root.dataset.noticeOff = d.notice;
          // the wall's "Fela síur" (ArchiveView): set before paint so a hidden rail doesn't flash and fold
          if (localStorage.getItem('mos-filters-hidden') === '1') root.dataset.filtersHidden = '';
        } catch (e) { /* storage blocked or unreadable: show the bars */ }
      })();
    </script>

    <!-- Product photos: a broken one falls back to the placeholder (external, so an enforced CSP allows it). -->
    <script is:inline src="/img-fallback.js" defer></script>

    <!-- Per-page <head> injection (canonical overrides, Product/BreadcrumbList JSON-LD). -->
    <slot name="head" />
  </head>
  <body class:list={[distractionFree && 'is-checkout']}>
    <a class="skip-link" href="#main">Beint í aðalefni</a>
    {
      distractionFree ? (
        <header class="checkout-header">
          <a class="checkout-header__logo" href="/" aria-label="Músík og Sport — forsíða">
            <img src={headerLogo.url} alt={headerLogo.alt || 'Músík og Sport'} width={headerLogo.width} height={headerLogo.height} />
          </a>
        </header>
      ) : (
        <>
          <CampaignBar text={chrome.campaign.text} textRight={chrome.campaign.textRight} />
          <SiteHeader chrome={chrome} />
        </>
      )
    }
    <main id="main">
      <slot />
    </main>
    {
      !distractionFree && (
        <>
          <SiteFooter chrome={chrome} />
          <SideMenu chrome={chrome} />
          <SearchOverlay />
          <StoreNotice text={chrome.campaign.notice} />
          <LoginPopup />
        </>
      )
    }
    <button class="to-top" type="button" data-to-top aria-label="Efst á síðu" hidden><Icon name="arrow-up" size={20} /></button>
    {!distractionFree && <CartDrawer client:idle shippingBar={miniCartBar} />}

    <script>
      const root = document.documentElement;

      // ── dismissible store notice (remembered per message text) ──
      document.querySelectorAll<HTMLElement>('[data-dismissible="notice"]').forEach((el) => {
        const key = el.dataset.key!;
        if (root.dataset.noticeOff && root.dataset.noticeOff !== key) delete root.dataset.noticeOff; // message changed
        el.querySelector('[data-dismiss]')?.addEventListener('click', (e) => {
          e.preventDefault();
          root.dataset.noticeOff = key;
          try {
            const d = JSON.parse(localStorage.getItem('mos-dismissed') || '{}');
            d.notice = key;
            localStorage.setItem('mos-dismissed', JSON.stringify(d));
          } catch (err) { /* storage blocked: hidden for this page only */ }
        });
      });

      // ── overlays: side menu + search (Escape closes, focus returns, page scroll locked) ──
      let lastTrigger: HTMLElement | null = null;
      function setOpen(el: HTMLElement | null, open: boolean, focusSel?: string) {
        if (!el) return;
        el.dataset.open = String(open);
        el.setAttribute('aria-hidden', String(!open));
        el.toggleAttribute('inert', !open);
        root.classList.toggle('overlay-open', open);
        if (open) (el.querySelector<HTMLElement>(focusSel ?? 'button'))?.focus();
        else lastTrigger?.focus();
      }
      const sideMenu = document.querySelector<HTMLElement>('[data-side-menu]');
      const search = document.querySelector<HTMLElement>('[data-search]');
      function showPanel(id: string) {
        sideMenu?.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => {
          if (p.dataset.panel === id) p.dataset.active = 'true';
          else delete p.dataset.active;
        });
      }
      function closeAll() {
        if (sideMenu?.dataset.open === 'true') {
          setOpen(sideMenu, false);
          document.querySelectorAll('[data-menu-open]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
          showPanel('root');
        }
        if (search?.dataset.open === 'true') setOpen(search, false);
      }

      // Tab stays inside an open side menu or search overlay (they are aria-modal), as in the cart drawer and the
      // filter sheet: from the last focusable item to the first and back, and into the overlay if focus left it.
      const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select, textarea, [tabindex]:not([tabindex="-1"])';
      function trapTab(e: KeyboardEvent) {
        const open = [sideMenu, search].find((el) => el?.dataset.open === 'true');
        if (!open) return;
        const items = [...open.querySelectorAll<HTMLElement>(FOCUSABLE)].filter((el) => el.getClientRects().length > 0);
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (!active || !open.contains(active)) {
          e.preventDefault();
          (e.shiftKey ? last : first).focus();
        } else if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAll();
        else if (e.key === 'Tab') trapTab(e);
      });

      // ── mega-menu: panels open on hover / focus-within (CSS); Escape closes the open one and puts focus
      //    back on its top link; it may open again once the pointer or focus has left that item ──
      const mainNav = document.querySelector<HTMLElement>('[data-main-nav]');
      mainNav?.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const item = (e.target as HTMLElement).closest<HTMLElement>('.nav-item--parent');
        if (!item) return;
        item.dataset.suppress = '';
        item.querySelector<HTMLElement>(':scope > .nav-item__link')?.focus();
      });
      mainNav?.querySelectorAll<HTMLElement>('.nav-item--parent').forEach((item) => {
        const clear = () => delete item.dataset.suppress;
        item.addEventListener('mouseleave', clear);
        item.addEventListener('focusout', (e) => {
          if (!item.contains(e.relatedTarget as Node | null)) clear();
        });
      });
      // Clicking a top link (Börn) goes to its page, so its panel stays shut; on the new page the pointer is still over
      // the link, so no panel opens on hover until the pointer first moves, and the item it is on then stays shut until
      // the pointer leaves it.
      mainNav?.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('.nav-item--parent > .nav-item__link');
        if (link) (link.parentElement as HTMLElement).dataset.suppress = '';
      });
      document.addEventListener(
        'pointermove',
        (e) => {
          const item = (e.target as HTMLElement).closest<HTMLElement>('.main-nav .nav-item--parent');
          if (item) item.dataset.suppress = '';
          document.documentElement.dataset.navArmed = ''; // hover opens panels from now on (global.css)
        },
        { once: true },
      );

      // ── effects: cards, banners and product rows below the fold rise in as they scroll into view (global.css .reveal) ──
      // Only what starts out of sight is hidden, so the first screen never flickers; cards a server island or the
      // filters bring in later are picked up as they arrive.
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
        const REVEAL = '.product-card, .story, [data-carousel]';
        const seen = new WeakSet<Element>();
        const io = new IntersectionObserver(
          (entries) => {
            entries
              .filter((e) => e.isIntersecting)
              .forEach((e, i) => {
                const el = e.target as HTMLElement;
                el.style.setProperty('--reveal-i', String(Math.min(i, 5)));
                el.classList.add('is-in');
                io.unobserve(el);
                el.addEventListener('transitionend', () => el.classList.remove('reveal', 'is-in'), { once: true });
              });
          },
          { rootMargin: '0px 0px -40px 0px' },
        );
        const scan = (root: ParentNode) =>
          root.querySelectorAll<HTMLElement>(REVEAL).forEach((el) => {
            // a carousel rises in as one; its cards would otherwise fade in on every swipe
            if (seen.has(el) || (el.matches('.product-card') && el.closest('[data-carousel]'))) return;
            seen.add(el);
            if (el.getBoundingClientRect().top < innerHeight) return;
            el.classList.add('reveal');
            io.observe(el);
          });
        scan(document);
        new MutationObserver((records) => {
          for (const r of records) r.addedNodes.forEach((n) => n instanceof HTMLElement && scan(n.parentNode ?? n));
        }).observe(document.body, { childList: true, subtree: true });
      }

      // ── wishlist (localStorage, event-delegated so grids need no per-card island) ──
      const WKEY = 'mos-wishlist';
      // `path` (live /verslun/<cat>/<slug>/ URL) is optional: older snapshots only carry `slug`.
      interface WishItem { id: number; slug: string; path?: string; name: string; image: string; }
      function readWish(): WishItem[] {
        try {
          const a = JSON.parse(localStorage.getItem(WKEY) || '[]');
          return Array.isArray(a) ? a.filter((x) => x && typeof x.id === 'number') : [];
        } catch {
          return [];
        }
      }
      function writeWish(list: WishItem[]) {
        try {
          localStorage.setItem(WKEY, JSON.stringify(list));
        } catch (e) {
          /* private mode / quota */
        }
        window.dispatchEvent(new CustomEvent('mos:wishlist'));
      }
      function toggleWish(item: WishItem) {
        if (!item.id) return;
        const list = readWish();
        const i = list.findIndex((x) => x.id === item.id);
        if (i >= 0) list.splice(i, 1);
        else list.unshift(item);
        writeWish(list);
      }
      function syncWishUI() {
        const list = readWish();
        const ids = new Set(list.map((x) => x.id));
        document.querySelectorAll<HTMLElement>('[data-wish]').forEach((b) => {
          b.setAttribute('aria-pressed', String(ids.has(Number(b.dataset.id))));
        });
        document.querySelectorAll<HTMLElement>('[data-wish-count]').forEach((el) => {
          el.textContent = list.length ? String(list.length) : '';
          el.dataset.count = String(list.length);
        });
      }
      window.addEventListener('mos:wishlist', syncWishUI);
      window.addEventListener('storage', (e) => {
        if (e.key === WKEY) syncWishUI();
      });

      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;

        const menuOpen = t.closest<HTMLElement>('[data-menu-open]');
        if (menuOpen) {
          lastTrigger = menuOpen;
          menuOpen.setAttribute('aria-expanded', 'true');
          setOpen(sideMenu, true, '[data-menu-close]');
          return;
        }
        if (t.closest('[data-menu-close]')) {
          closeAll();
          return;
        }
        const panelOpen = t.closest<HTMLElement>('[data-panel-open]');
        if (panelOpen && sideMenu?.contains(panelOpen)) {
          e.preventDefault();
          showPanel(panelOpen.dataset.panelOpen!);
          return;
        }
        const back = t.closest<HTMLElement>('[data-panel-back]');
        if (back) {
          const parent = back.closest<HTMLElement>('[data-panel]')?.dataset.parent;
          if (parent) showPanel(parent);
          return;
        }
        const searchOpen = t.closest<HTMLElement>('[data-search-open]');
        if (searchOpen) {
          lastTrigger = searchOpen;
          setOpen(search, true, '[data-search-input]');
          return;
        }
        if (t.closest('[data-search-close]')) {
          closeAll();
          return;
        }
        if (t.closest('[data-to-top]')) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }

        const wishBtn = t.closest<HTMLElement>('[data-wish]');
        if (wishBtn) {
          e.preventDefault();
          toggleWish({
            id: Number(wishBtn.dataset.id),
            slug: wishBtn.dataset.slug || '',
            path: wishBtn.dataset.path || undefined,
            name: wishBtn.dataset.name || '',
            image: wishBtn.dataset.image || '',
          });
          return;
        }
      });

      // Sticky header state + back-to-top visibility.
      const header = document.querySelector<HTMLElement>('[data-header]');
      const toTop = document.querySelector<HTMLElement>('[data-to-top]');
      const onScroll = () => {
        const y = window.scrollY;
        if (header) header.dataset.stuck = String(y > 4);
        if (toTop) toTop.hidden = y < 600;
      };
      window.addEventListener('scroll', onScroll, { passive: true });

      onScroll();
      syncWishUI();
    </script>
  </body>
</html>
