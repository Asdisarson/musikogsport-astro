---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CartDrawer from '../components/CartDrawer.tsx';
import { ld } from '../lib/jsonld';

interface Props {
  title?: string;
  description?: string;
  /** Absolute (or root-relative) image URL for og:image / twitter:image. */
  image?: string;
  /** Open Graph type — 'website' (default) or 'product' on PDPs. */
  ogType?: string;
  /** Emit a noindex robots meta (cart/checkout/transient pages). */
  noindex?: boolean;
}
const { title, description, image, ogType = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} — Músík og Sport` : 'Músík og Sport — Íþróttavörur frá fagfólki';
const desc =
  description ??
  'Íþróttavörur, hlaupaskór, fatnaður og útivist frá fagfólki. Yfir 30 ára reynsla, vönduð vörumerki og persónuleg þjónusta.';

// Absolute URLs for canonical + social tags (Astro.site = https://musikogsport.is).
const siteUrl = Astro.site?.href ?? 'https://musikogsport.is/';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = image ? new URL(image, siteUrl).href : undefined;

// Site-wide structured data (identical on every page).
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Músík og Sport ehf.',
  url: siteUrl,
  logo: new URL('/favicon.svg', siteUrl).href,
  email: 'musikogsport@musikogsport.is',
  telephone: '+354 555 2887',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Dalshraun 10',
    postalCode: '220',
    addressLocality: 'Hafnarfjörður',
    addressCountry: 'IS',
  },
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Músík og Sport',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}leita?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="is">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141714" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Músík og Sport" />
    <meta property="og:locale" content="is_IS" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Site-wide structured data -->
    <script type="application/ld+json" is:inline set:html={ld(orgLd)} />
    <script type="application/ld+json" is:inline set:html={ld(websiteLd)} />

    <!-- preload the two hero faces to avoid FOUT on the headline -->
    <link rel="preload" href="/fonts/schibsted-grotesk-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- no-flash theme: apply stored choice before first paint (light is primary) -->
    <script is:inline>
      (() => {
        // mark JS available so reveal-animations engage (no-JS shows content as-is)
        document.documentElement.classList.add('js');
        try {
          document.documentElement.dataset.theme = localStorage.getItem('mos-theme') || 'light';
        } catch (e) {}
      })();
    </script>

    <!-- Per-page <head> injection (canonical overrides, Product/BreadcrumbList JSON-LD). -->
    <slot name="head" />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Beint í aðalefni</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <CartDrawer client:idle />

    <!-- behaviour: theme toggle · sticky header · mobile nav · scroll-reveal -->
    <script>
      // One-time, document-level wiring (survives view transitions).
      const root = document.documentElement;

      function setTheme(theme: string) {
        root.dataset.theme = theme;
        try {
          localStorage.setItem('mos-theme', theme);
        } catch (e) {}
        document
          .querySelectorAll<HTMLElement>('[data-theme-toggle]')
          .forEach((b) => b.setAttribute('aria-pressed', String(theme === 'dark')));
      }

      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const themeBtn = t.closest('[data-theme-toggle]');
        if (themeBtn) {
          setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
          return;
        }
        const navBtn = t.closest('[data-nav-toggle]');
        if (navBtn) {
          const nav = document.querySelector<HTMLElement>('.main-nav');
          const open = nav?.dataset.open === 'true';
          if (nav) nav.dataset.open = String(!open);
          navBtn.setAttribute('aria-expanded', String(!open));
          return;
        }
        // PDP gallery: swap the main image when a thumbnail is clicked.
        const thumb = t.closest<HTMLElement>('.pdp__thumb');
        if (thumb) {
          const main = document.getElementById('pdp-main') as HTMLImageElement | null;
          const full = thumb.dataset.full;
          if (main && full) {
            main.src = full;
            if (thumb.dataset.alt) main.alt = thumb.dataset.alt;
            document.querySelectorAll('.pdp__thumb').forEach((o) => o.removeAttribute('aria-current'));
            thumb.setAttribute('aria-current', 'true');
          }
        }
      });

      // Sticky-header shadow on scroll.
      const onScroll = () => {
        const header = document.querySelector<HTMLElement>('.site-header');
        if (header) header.dataset.stuck = String(window.scrollY > 4);
      };
      window.addEventListener('scroll', onScroll, { passive: true });

      // Scroll-reveal — re-init for each page (initial load + view transitions).
      let observer: IntersectionObserver | null = null;
      function initReveal() {
        observer?.disconnect();
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        observer = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('is-in');
                observer!.unobserve(en.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => observer!.observe(el));
      }

      function onPage() {
        // close mobile nav after navigation
        const nav = document.querySelector<HTMLElement>('.main-nav');
        if (nav) nav.dataset.open = 'false';
        onScroll();
        initReveal();
      }

      document.addEventListener('astro:page-load', onPage);
      onPage();
    </script>
  </body>
</html>
