---
// /merkimidar/<slug>/[page/N/] — product tag archive in live's URL shape.
import Base from '../../layouts/Base.astro';
import ArchiveView from '../../components/ArchiveView.astro';
import NotFound from '../../components/NotFound.astro';
import { loadArchive } from '../../lib/archive';
import { filterTitle } from '../../lib/facets';
import { loadCatalogTerms } from '../../lib/catalogTerms';
import { archiveHref, pageLinks, splitPagination } from '../../lib/paths';
import { markUnavailable } from '../../lib/http';

export const prerender = false;

const params = Astro.url.searchParams;
const segments = (Astro.params.path ?? '').split('/').filter(Boolean);
const split = splitPagination(segments);
const pageOne = !split && segments.length === 3 && segments[2] === '1' ? archiveHref(`/merkimidar/${segments[0]}/`, 1, params) : null;
if (pageOne) return Astro.redirect(pageOne, 301);
const terms = await loadCatalogTerms();
const tag = split && split.segments.length === 1 ? terms.tags.find((t) => t.slug === split.segments[0]) : undefined;
const page = split?.page ?? 1;
const archive = tag ? await loadArchive(params, page, { tagId: tag.id }) : null;
const found = Boolean(tag && archive && !archive.unavailable && page <= Math.max(1, archive.result.totalPages));
const down = terms.degraded || Boolean(archive?.unavailable);
if (down) markUnavailable(Astro.response);
else if (!found) Astro.response.status = 404;
const basePath = tag ? `/merkimidar/${tag.slug}/` : '/';
const crumbs = [{ label: 'Heim', href: '/' }, { label: 'Verslun', href: '/verslun/' }, { label: `Vörur merktar „${tag?.name ?? ''}“` }];
---

{
  found && archive && tag ? (
    <Base pageLinks={pageLinks(basePath, page, archive.result.totalPages, params)} title={page > 1 ? `${filterTitle(tag.name, archive.activeLabels)} — síða ${page}` : filterTitle(tag.name, archive.activeLabels)}>
      <ArchiveView title={tag.name} crumbs={crumbs} basePath={basePath} params={params} archive={archive} page={page} />
    </Base>
  ) : (
    <Base title={down ? 'Tímabundin bilun' : 'Merkimiði fannst ekki'}>
      <NotFound unavailable={down} title="Merkimiði fannst ekki" message="Þessi merkimiði er ekki til." />
    </Base>
  )
}
