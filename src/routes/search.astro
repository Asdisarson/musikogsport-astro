---
// Legacy app-astro search URL (/leita?q=) → 301 to live's WordPress-style /?s=<q>&post_type=product.
import { legacySearchTarget } from '../lib/paths';

export const prerender = false;

const target = legacySearchTarget(Astro.url.searchParams.get('q'));
// Always true; kept because astro check counts nothing read only by an unconditional frontmatter `return`.
if (target) return Astro.redirect(target, 301);
---
