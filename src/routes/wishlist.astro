---
// /oskalisti/ — live's wishlist page (WP page "Óskalisti", YITH wishlist) in the content-page layout.
import Base from '../layouts/Base.astro';
import WishlistView from '../components/WishlistView.tsx';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store'); // wishlist is per-shopper — never cache
---

<Base title="Óskalisti" noindex>
  <header class="page-header">
    <h1 class="page-title">Óskalisti</h1>
  </header>
  <div class="wp-page container">
    <WishlistView client:load />
  </div>
</Base>
