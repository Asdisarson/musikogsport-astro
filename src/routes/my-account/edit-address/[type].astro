---
import AccountLayout from '../../../components/AccountLayout.astro';
import { currentUser } from '../../../lib/auth';
import { loadCustomer, updateCustomer, UNAVAILABLE_TEXT } from '../../../lib/account';
import { markUnavailable, sameOrigin } from '../../../lib/http';
import { addressFormFields, addressFromForm, addressProblems, type Address, type AddressField } from '../../../lib/accountFormat';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

const type = Astro.params.type;
if (type !== 'billing' && type !== 'shipping') return Astro.redirect('/min-sida/edit-address/');
const user = await currentUser(Astro.cookies);
if (!user) return Astro.redirect('/min-sida/');
const title = type === 'billing' ? 'Greiðsluheimilisfang' : 'Sendingarheimilisfang';
const fields = addressFormFields(type);

// The form posts to this page, so a submission that cannot be saved comes back with what the customer typed and
// with each problem at its own field. Only the signed-in customer's own address is written.
let submitted: Address | null = null;
let problems = new Map<AddressField, string>();
let saveFailed = false;
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request, Astro.url)) return new Response('Forbidden', { status: 403 });
  const form = await Astro.request.formData().catch(() => null);
  if (!form) {
    saveFailed = true;
  } else {
    submitted = addressFromForm(form, type);
    problems = addressProblems(submitted, type);
    if (problems.size === 0) {
      try {
        await updateCustomer(user.id, { [type]: submitted });
        return Astro.redirect('/min-sida/edit-address/?saved=1', 303);
      } catch {
        saveFailed = true;
      }
    }
  }
}

let a: Address;
let down = false;
if (submitted) {
  a = submitted;
} else {
  const loaded = await loadCustomer(user.id);
  // WooCommerce down: no form (blank fields a customer could submit), a 503 with the outage notice instead.
  down = loaded === 'unavailable';
  if (down) markUnavailable(Astro.response);
  a = (loaded === 'unavailable' ? null : type === 'billing' ? loaded?.billing : loaded?.shipping) ?? {};
}
if (problems.size > 0) Astro.response.status = 422;

const notice = down
  ? { kind: 'error' as const, text: UNAVAILABLE_TEXT }
  : saveFailed
  ? { kind: 'error' as const, text: 'Ekki tókst að vista heimilisfangið. Reyndu aftur.' }
  : null;
---

<AccountLayout title={title} current="edit-address" notice={notice}>
  <h2 class="account__h2">{title}</h2>
  {!down && (
  <form class="account-form account-fields" method="post" action={`/min-sida/edit-address/${type}/`} novalidate>
    {
      fields.map((f) => {
        const problem = problems.get(f.name);
        return (
          <p class:list={['form-row', `form-row-${f.width}`, { 'is-invalid': problem }]}>
            <input
              class="input-text"
              id={f.name}
              name={f.name}
              type={f.type ?? 'text'}
              value={a[f.name] ?? ''}
              placeholder=" "
              autocomplete={f.autocomplete}
              aria-required={f.required ? 'true' : undefined}
              aria-invalid={problem ? 'true' : undefined}
              aria-describedby={problem ? `${f.name}_error` : undefined}
            />
            <label for={f.name}>
              {f.label}
              {f.required ? <abbr class="required" title="nauðsynlegt"> *</abbr> : <span class="optional"> (valfrjálst)</span>}
            </label>
            {problem && <span class="field-error" id={`${f.name}_error`}>{problem}</span>}
          </p>
        );
      })
    }
    <p class="form-row form-row-wide has-val">
      <input class="input-text" id="country" value="Ísland" readonly />
      <label for="country">Land</label>
    </p>
    <button class="btn-dark" type="submit">Vista heimilisfang</button>
  </form>
  )}
</AccountLayout>
