---
// Staff admin bar: links into wp-admin for a signed-in account that may edit products ("Breyta vöru" on a
// product page, then the sections). Public pages are the same for every visitor (lib/cachePolicy), so the bar
// ships empty and hidden and the browser fills it in, on either sign-in:
// - wp-admin: WordPress leaves the `mos_staff` flag cookie on the shared host while staff are signed in
//   (wp-mu-plugins/mos-staff-flag.php). No request: the bar carries wp-admin's origin, the same for everyone.
// - the storefront login: when the `mos_li` flag says someone is signed in, /api/account/editor/ says whether
//   they are staff. The answer is kept for the tab's session so customers cost one request.
// Neither flag is a credential: the bar is only links, and wp-admin asks for its own login.
import { MEDIA_BASE_URL } from '../lib/img';
import { runtimeEnv } from '../lib/logger';

// WordPress's public origin, as api/account/editor answers it: MOS_WP_ADMIN_URL where set, else the media host.
const adminBase = runtimeEnv('MOS_WP_ADMIN_URL') || MEDIA_BASE_URL;
---

<nav class="admin-bar" data-admin-bar data-admin-base={adminBase} aria-label="Stjórnun" hidden></nav>

<script>
  import { adminBarLinks, hasCookie } from '../lib/editor';

  const KEY = 'mos_admin_bar'; // '' = not staff, otherwise WordPress's public origin
  const bar = document.querySelector<HTMLElement>('[data-admin-bar]');

  function read(): string | null {
    try {
      return sessionStorage.getItem(KEY);
    } catch {
      return null;
    }
  }
  function write(value: string | null): void {
    try {
      if (value === null) sessionStorage.removeItem(KEY);
      else sessionStorage.setItem(KEY, value);
    } catch {
      /* storage blocked: ask again on the next page */
    }
  }

  function show(base: string): void {
    if (!bar) return;
    const product = Number(document.querySelector<HTMLElement>('[data-edit-product]')?.dataset.editProduct);
    const links = adminBarLinks(base, Number.isFinite(product) ? product : null);
    if (!links.length) return;
    bar.replaceChildren(
      ...links.map(({ label, href }) => {
        const a = document.createElement('a');
        a.href = href;
        a.textContent = label;
        a.target = '_blank';
        a.rel = 'noopener';
        return a;
      }),
    );
    bar.hidden = false;
    document.documentElement.classList.add('has-admin-bar');
  }

  function hide(): void {
    if (!bar || bar.hidden) return;
    bar.hidden = true;
    document.documentElement.classList.remove('has-admin-bar');
  }

  /** WordPress's origin when this browser is signed in as staff on either path, '' when it is not, and null when
   *  that couldn't be asked just now (the bar then stays as it is). */
  async function staffBase(): Promise<string | null> {
    if (hasCookie(document.cookie, 'mos_staff')) return bar?.dataset.adminBase ?? '';
    if (!hasCookie(document.cookie, 'mos_li')) {
      write(null); // signed out: forget the last account's answer
      return '';
    }
    const known = read();
    if (known !== null) return known;
    try {
      const res = await fetch('/api/account/editor/', { headers: { Accept: 'application/json' } });
      if (!res.ok) return null;
      const data = (await res.json()) as { canEdit?: boolean; adminBase?: string };
      const base = data.canEdit === true && typeof data.adminBase === 'string' ? data.adminBase : '';
      write(base);
      return base;
    } catch {
      return null; // offline or the server is away
    }
  }

  let checking = false;
  let again = false;
  async function refresh(): Promise<void> {
    if (checking) {
      again = true; // asked while a check was under way: look once more when it is done
      return;
    }
    checking = true;
    try {
      const base = await staffBase();
      if (base) show(base);
      else if (base === '') hide();
    } finally {
      checking = false;
      if (again) {
        again = false;
        void refresh();
      }
    }
  }

  if (bar) {
    void refresh();
    // Signing in or out happens in another tab (wp-admin) or on a page this one is restored over, so the page
    // looks again when it comes back: to the foreground, or out of the back/forward cache.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') void refresh();
    });
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) void refresh();
    });
  }
</script>
