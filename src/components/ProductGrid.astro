---
import type { WooProduct } from '../lib/types';
import ProductCard from './ProductCard.astro';

interface Props {
  products: WooProduct[];
  empty?: string;
  /** Eager-load (no lazy) the first N cards — set on listing pages so the LCP image isn't deferred. */
  eagerCount?: number;
}
const { products, empty = 'Engar vörur fundust.', eagerCount = 0 } = Astro.props;
---

{
  products.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul class="product-grid">
      {products.map((p, i) => (
        <li>
          <ProductCard product={p} eager={i < eagerCount} />
        </li>
      ))}
    </ul>
  )
}
