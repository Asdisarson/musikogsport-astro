---
// The product page's related products as the home tile carousel: "Þér gæti líkað" in the uppercase display face,
// round arrows top-right, tiles from the page gutter bleeding off the right edge. Up to 12 of them: the best sellers
// in stock from the product's most specific category for the same audience (lib/categoryTree relatedScope — a men's
// running shoe gets men's running shoes), then WooCommerce's own related_ids if that comes up short. The wrapper
// sets the --edge the home rows read (.home sets it on the home page).
// A server island (`server:defer` on the product page): the uncached product lookups run after the page has been
// sent, not before it. ProductRow's carousel script comes back with the island HTML, and Astro's island loader
// inserts it with createContextualFragment, which runs it.
import { productImage } from '../lib/img';
import { settlePhotos } from '../lib/photoBgServer';
import { storeProducts } from '../lib/storeCatalog';
import type { WooProduct } from '../lib/types';
import { getProductsByIds } from '../lib/woo';
import ProductRow from './ProductRow.astro';

interface Props {
  /** The product itself, never shown. */
  productId: number;
  /** relatedScope: the category to draw from (none: related_ids only) and the audiences it's narrowed to. */
  categoryId?: number;
  audienceIds: number[];
  /** WooCommerce's related_ids, the top-up. */
  ids: number[];
}
const { productId, categoryId, audienceIds, ids } = Astro.props;
const LIMIT = 12;

// Either lookup failing just leaves its share out; both failing shows no row, as before the island.
const scoped: WooProduct[] = categoryId
  ? await storeProducts({ categoryIds: [categoryId], andCategoryIds: audienceIds, stockStatus: ['instock'], orderby: 'popularity', order: 'desc', per_page: LIMIT + 1 })
      .then((r) => r.items)
      .catch(() => [])
  : [];
const seen = new Set([productId, ...scoped.map((p) => p.id)]);
const missing = LIMIT - (scoped.length - (scoped.some((p) => p.id === productId) ? 1 : 0));
const topUp = missing > 0 ? await getProductsByIds(ids.filter((id) => !seen.has(id)), missing).catch(() => []) : [];
const products = [...scoped.filter((p) => p.id !== productId), ...topUp].slice(0, LIMIT);
// The tiles fill around each photo as the wall's cards do (lib/photoBg cardFill), which needs the photo read first;
// renders never wait for that, but this island is already off the critical path, so it waits a moment for them.
await settlePhotos(products.map(productImage), 2000);
---

{
  products.length > 0 && (
    <div class="pdp-related">
      <ProductRow title="Þér gæti líkað" products={products} />
    </div>
  )
}
