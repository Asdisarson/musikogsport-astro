---
// The product page's related products as the home tile carousel: "Þér gæti líkað" in the uppercase display face,
// round arrows top-right, tiles from the page gutter bleeding off the right edge. It shows up to 12 of them:
// the products the shop linked by hand ("Tengdar vörur": upsells, then cross-sells), then the best sellers from the
// product's most specific category for the same audience (lib/categoryTree relatedScope — a men's running shoe gets
// men's running shoes), then WooCommerce's own related_ids if that comes up short. The wrapper sets the --edge the
// home rows read (.home sets it on the home page).
// Stock does not decide what this HTML names: it is held at the CDN, so a sold-out product and a restocked one would
// stay wrong there for minutes. The server renders about twice the row's length as candidates, in row order. The first
// 12 are visible as rendered; the rest are spares, rendered hidden, so without JavaScript (or before the live answer,
// or when it fails) the row shows exactly 12. The browser (components/ProductCard script, lib/relatedPicks
// relatedVisible) then hides the ones the live answer names sold out and reveals spares in their place.
// A server island (`server:defer` on the product page): the uncached product lookups run after the page has been
// sent, not before it. ProductRow's carousel script comes back with the island HTML, and Astro's island loader
// inserts it with createContextualFragment, which runs it.
import { markDegraded } from '../lib/http';
import { productImage } from '../lib/img';
import { log } from '../lib/logger';
import { settlePhotos } from '../lib/photoBgServer';
import { relatedRequests } from '../lib/relatedLimit';
import { relatedOrder } from '../lib/relatedPicks';
import { storeProducts } from '../lib/storeCatalog';
import type { CachedWooProduct } from '../lib/types';
import { visitorKey } from '../lib/visitor';
import { getProductsByIds } from '../lib/woo';
import ProductRow from './ProductRow.astro';

interface Props {
  /** The product itself, never shown. */
  productId: number;
  /** The shop's hand-picked linked products (lib/relatedPicks pickedIds), which lead the row. */
  picked?: number[];
  /** relatedScope: the category to draw from (none: related_ids only) and the audiences it's narrowed to. */
  categoryId?: number;
  audienceIds: number[];
  /** WooCommerce's related_ids, the top-up. */
  ids: number[];
}
const { productId, picked = [], categoryId, audienceIds, ids } = Astro.props;
// How many the row shows, and how many the server names: the extra ones are spares for the browser to reveal when a
// shown product turns out sold out (lib/relatedPicks relatedVisible). Capped well inside one live call (LIVE_MAX_IDS).
const LIMIT = 12;
const CANDIDATES = 2 * LIMIT;
const PICKED_FETCH = CANDIDATES;

// Over the visitor's limit the row is simply left out, as when every lookup fails.
const allowed = relatedRequests.take(visitorKey(Astro));
// A row left out for this visitor, or short because a lookup failed, must not be held at the CDN for everyone.
let partial = !allowed;
// Any lookup failing just leaves its share out; all failing shows no row, as before the island.
const [pickedProducts, scoped]: [CachedWooProduct[], CachedWooProduct[]] = await Promise.all([
  allowed && picked.length > 0
    ? getProductsByIds(picked, PICKED_FETCH).catch((err) => {
        log.warn('[related] hand-picked lookup failed', { productId, err });
        partial = true;
        return [];
      })
    : [],
  allowed && categoryId
    ? storeProducts({ categoryIds: [categoryId], andCategoryIds: audienceIds, orderby: 'popularity', order: 'desc', per_page: CANDIDATES + 1 })
        .then((r) => r.items.filter((p) => p.id !== productId))
        .catch((err) => {
          log.warn('[related] category best sellers failed', { productId, categoryId, err });
          partial = true;
          return [];
        })
    : [],
]);
const leading = relatedOrder({ productId, picked: pickedProducts, scoped, topUp: [], limit: CANDIDATES });
// The top-up never brings back a hand-picked product, sold out or not: each is already a candidate, or was asked for.
const seen = new Set([productId, ...picked, ...leading.map((p) => p.id)]);
const missing = CANDIDATES - leading.length;
const topUp =
  allowed && missing > 0
    ? await getProductsByIds(ids.filter((id) => !seen.has(id)), missing).catch((err) => {
        log.warn('[related] related_ids top-up failed', { productId, err });
        partial = true;
        return [];
      })
    : [];
if (partial) markDegraded(Astro.response);
const products = relatedOrder({ productId, picked: pickedProducts, scoped, topUp, limit: CANDIDATES });
// The tiles fill around each photo as the wall's cards do (lib/photoBg cardFill), which needs the photo read first;
// renders never wait for that, but this island is already off the critical path, so it waits a moment for them.
// A photo whose colours were not read yet leaves its tile on the default background: that row is not held at the CDN.
if (!(await settlePhotos(products.map(productImage), 2000))) markDegraded(Astro.response);
---

{
  products.length > 0 && (
    <div class="pdp-related" data-related-limit={LIMIT}>
      <ProductRow title="Þér gæti líkað" products={products} shown={LIMIT} />
    </div>
  )
}
