---
// The product page's related products (live: "Tengdar vörur", five of them) as the home tile carousel:
// "Þér gæti líkað" in the uppercase display face, round arrows top-right, square #F5F5F5 tiles from the page gutter
// bleeding off the right edge. The wrapper sets the --edge the home rows read (.home sets it on the home page).
import type { WooProduct } from '../lib/types';
import ProductRow from './ProductRow.astro';

interface Props {
  products: WooProduct[];
}
const { products } = Astro.props;
---

{
  products.length > 0 && (
    <div class="pdp-related">
      <ProductRow title="Þér gæti líkað" products={products} />
    </div>
  )
}
