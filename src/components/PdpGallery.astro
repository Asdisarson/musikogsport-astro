---
// The product gallery (nike-look, SPEC § PDP). From 992px: a sticky column of 60×60 thumbnails beside every image
// stacked as white tiles of the photo's own shape (lib/photoBg tileAspect; 4:5 until it's known) that scroll with the page; a thumbnail scrolls its image into view and the one in
// view is marked. Below 992px the same track is a full-bleed swipe carousel of 4:5 slides with a "1 / N" counter. Every image
// opens the lightbox. `viewer` (shoes, as on nike.com) keeps the carousel on a desktop too: one 4:5 photo at a time beside
// the thumbnails, which pick it (click or hover), with ‹ › in its corner. The first image is #pdp-main so the purchase island can swap in a variation's photo; it gets
// no srcset, because the island swaps it by setting `src`, which a srcset would override. Its AVIF/WebP sources sit
// in the <picture> around it, and the island replaces them with the variation photo's when it swaps (lib/img mainSources).
import Icon from './Icon.astro';
import ProductImage from './ProductImage.astro';
import { mediaSrcset, mediaUrl, PLACEHOLDER } from '../lib/img';
import { subSizeAspect, TILE_ASPECT } from '../lib/photoBg';
import { photoAspectOf, photoFitFor, settlePhotos } from '../lib/photoBgServer';
import { markIncomplete } from '../lib/shellIncomplete';
import type { WooImage } from '../lib/types';

interface Props {
  images: WooImage[];
  name: string;
  /** One photo at a time on a desktop too (shoes). */
  viewer?: boolean;
}
const { images, name, viewer = false } = Astro.props;
const SIZES = '(min-width: 1200px) 532px, (min-width: 992px) 45vw, 100vw';
const slides = images.length
  ? images.map((im) => ({
      src: mediaUrl(im.src) || PLACEHOLDER,
      srcset: mediaSrcset(im.srcset),
      thumb: mediaUrl(im.thumbnail) || mediaUrl(im.src) || PLACEHOLDER,
      alt: im.alt || name,
    }))
  : [{ src: PLACEHOLDER, srcset: '', thumb: PLACEHOLDER, alt: name }];
// each photo's own backdrop colour for its tile and thumbnail when flat and known, and how the tile draws it
// (lib/photoBg photoFit). The first tile's follows a variation's photo when the purchase island swaps #pdp-main
// (ProductPurchase). A thumbnail shows WordPress' own (usually square-cropped) rendition, so it's judged by that
// rendition's shape, read from its file name.
// The shapes need each photo read first: a short wait, bounded, so even a first view gets them (lib/photoBgServer).
// A photo still unread at the bound leaves a default tile: the page is served but not kept (see markIncomplete).
if (!(await settlePhotos(slides, 800))) markIncomplete(Astro);
const bgs = slides.map((im) => {
  const attrs = photoFitFor(im.src, im.srcset, TILE_ASPECT.gallery);
  const aspect = viewer ? null : photoAspectOf(im.src, im.srcset); // the viewer's tiles are all 4:5
  return aspect === null ? attrs : { ...attrs, style: [attrs.style, `--tile-aspect:${aspect}`].filter(Boolean).join(';') };
});
const thumbBgs = slides.map((im) => photoFitFor(im.src, im.srcset, TILE_ASPECT.thumb, subSizeAspect(im.thumb)));
const many = slides.length > 1;
---

<div class:list={['pdp-gallery', many && 'pdp-gallery--many', viewer && 'pdp-gallery--viewer']} data-gallery data-gallery-viewer={viewer ? '' : undefined}>
  {
    many && (
      <div class="pdp-thumbs" data-gallery-thumbs>
        {slides.map((im, i) => (
          <button type="button" class="pdp-thumb" data-thumb={i} aria-label={`Sýna mynd ${i + 1} af ${slides.length}`} aria-current={i === 0 ? 'true' : undefined} {...thumbBgs[i]}>
            <ProductImage src={im.thumb} alt={i === 0 ? name : `${name} – mynd ${i + 1}`} width={60} height={60} />
          </button>
        ))}
      </div>
    )
  }
  <div class="pdp-gallery__main">
    <div class="pdp-gallery__track" data-gallery-track>
      {
        slides.map((im, i) => (
          <figure class="pdp-gallery__item" data-gallery-item={i}>
            <a href={im.src} data-lightbox={i} aria-label={`Stækka mynd ${i + 1} af ${slides.length}`} {...bgs[i]}>
              <ProductImage
                id={i === 0 ? 'pdp-main' : undefined}
                src={im.src}
                srcset={i === 0 ? undefined : im.srcset}
                lightFrom={i === 0 ? im.srcset : undefined}
                sizes={SIZES}
                alt={im.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </a>
          </figure>
        ))
      }
    </div>
    {
      many && viewer && (
        <div class="pdp-gallery__steps">
          <button class="round-btn" type="button" data-gallery-step="-1" aria-label="Fyrri mynd">
            <Icon name="chevron-left" size={24} stroke-width={1.5} />
          </button>
          <button class="round-btn" type="button" data-gallery-step="1" aria-label="Næsta mynd">
            <Icon name="chevron-right" size={24} stroke-width={1.5} />
          </button>
        </div>
      )
    }
    {
      many && (
        <p class="pdp-gallery__count" aria-hidden="true">
          <span data-gallery-count>1</span> / {slides.length}
        </p>
      )
    }
  </div>
  <dialog class="lightbox" data-lightbox-dialog aria-label={`Myndir: ${name}`}>
    <img class="lightbox__img" alt="" data-lightbox-img />
    <p class="lightbox__count" data-lightbox-count></p>
    <button class="lightbox__btn lightbox__btn--close" type="button" data-lightbox-close aria-label="Loka">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    {
      many && (
        <>
          <button class="lightbox__btn lightbox__btn--prev" type="button" data-lightbox-step="-1" aria-label="Fyrri mynd">
            <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          </button>
          <button class="lightbox__btn lightbox__btn--next" type="button" data-lightbox-step="1" aria-label="Næsta mynd">
            <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          </button>
        </>
      )
    }
  </dialog>
</div>

<script>
  const desktop = window.matchMedia('(min-width: 992px)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-gallery-track]')!;
    const items = [...track.querySelectorAll<HTMLElement>('[data-gallery-item]')];
    const thumbCol = root.querySelector<HTMLElement>('[data-gallery-thumbs]');
    const thumbs = [...root.querySelectorAll<HTMLElement>('[data-thumb]')];
    const counter = root.querySelector<HTMLElement>('[data-gallery-count]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox-dialog]')!;
    const big = root.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const count = root.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const imgs = () => [...track.querySelectorAll<HTMLImageElement>('img')];
    const isViewer = root.hasAttribute('data-gallery-viewer');
    const behavior = (): ScrollBehavior => (reduceMotion.matches ? 'auto' : 'smooth');
    let index = 0;

    const show = (i: number) => {
      const list = imgs();
      index = (i + list.length) % list.length;
      // the full-size `src`, not currentSrc (the small srcset candidate the tile chose); it still follows the island's
      // #pdp-main variation swap and the shared photo fallback (public/img-fallback.js), which both set `src`
      big.src = list[index].src;
      big.alt = list[index].alt;
      count.textContent = list.length > 1 ? `${index + 1} / ${list.length}` : '';
    };

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const thumb = t.closest<HTMLElement>('[data-thumb]');
      if (thumb) {
        if (isViewer) slideTo(Number(thumb.dataset.thumb));
        else items[Number(thumb.dataset.thumb)]?.scrollIntoView({ behavior: behavior(), block: 'start' });
        return;
      }
      const slide = t.closest<HTMLElement>('[data-gallery-step]');
      if (slide) return slideTo((current + Number(slide.dataset.galleryStep) + items.length) % items.length);
      const open = t.closest<HTMLElement>('[data-lightbox]');
      if (open) {
        e.preventDefault();
        show(Number(open.dataset.lightbox));
        dialog.showModal();
        return;
      }
      const step = t.closest<HTMLElement>('[data-lightbox-step]');
      if (step) return show(index + Number(step.dataset.lightboxStep));
      if (t.closest('[data-lightbox-close]') || t === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });

    // The viewer (and the phone carousel): show slide i by scrolling the track sideways, never the page.
    // `heading`: the slide a scroll from here is still on its way to; the slides it passes aren't marked, so a second
    // ‹ › steps on from the target, not from wherever the scroll is
    let heading: number | null = null;
    function slideTo(i: number, smooth = true, reveal = true) {
      mark(i, reveal);
      heading = i;
      track.scrollTo({ left: i * track.clientWidth, behavior: smooth ? behavior() : 'auto' });
    }

    if (items.length < 2) return;

    // Desktop: mark the thumbnail of the image most in view, and keep it visible inside its own (scrolling) column
    // by moving that column only — never the page.
    let current = 0;
    // `reveal`: also scroll the thumbnail column to it (not on hover: the column would move under the pointer)
    const mark = (i: number, reveal = true) => {
      if (i === current) return;
      current = i;
      thumbs.forEach((b, j) => (j === i ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
      const b = thumbs[i];
      if (thumbCol && b && reveal) {
        // the column's padding (room for the focus ring) stays in view with the thumb
        const pad = parseFloat(getComputedStyle(thumbCol).paddingTop) || 0;
        const top = b.offsetTop - pad;
        const bottom = b.offsetTop + b.offsetHeight + pad;
        if (top < thumbCol.scrollTop) thumbCol.scrollTop = top;
        else if (bottom > thumbCol.scrollTop + thumbCol.clientHeight) thumbCol.scrollTop = bottom - thumbCol.clientHeight;
      }
    };
    let queued = false;
    const onPageScroll = () => {
      if (queued || !desktop.matches || isViewer) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        let best = 0;
        let bestSeen = -1;
        items.forEach((it, i) => {
          const r = it.getBoundingClientRect();
          const seen = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0);
          if (seen > bestSeen + 1) {
            best = i;
            bestSeen = seen;
          }
        });
        mark(best);
      });
    };
    window.addEventListener('scroll', onPageScroll, { passive: true });

    // The carousel's "1 / N" (phones), and in the viewer the thumbnail of the photo in view.
    track.addEventListener(
      'scroll',
      () => {
        const at = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
        if (counter) counter.textContent = String(at + 1);
        if (!isViewer) return;
        if (heading === null) mark(Math.min(at, items.length - 1));
        else if (at === heading) heading = null;
      },
      { passive: true },
    );
    // nike.com's shoe thumbnails show their photo on hover
    if (isViewer) {
      thumbs.forEach((b, i) => b.addEventListener('mouseenter', () => desktop.matches && slideTo(i, false, false)));
      // a scroll that ends short of its target (the user swiped on) lets go of it
      track.addEventListener('scrollend', () => {
        heading = null;
        mark(Math.min(Math.round(track.scrollLeft / Math.max(1, track.clientWidth)), items.length - 1));
      });
    }
  });
</script>
