---
// Product carousels (nike-look): the home rows, the product page's "Þér gæti líkað" and the empty cart's
// suggestions. An uppercase display title with two round arrows top-right, then square #F5F5F5 tiles (440px at
// 1440, ~300px on phones with the next one peeking), bleeding off the right edge. Scroll-snap does the sliding;
// the arrows step one tile at a time.
import ProductCard from './ProductCard.astro';
import type { CachedWooProduct } from '../lib/types';
import { isRowSpare } from '../lib/relatedPicks';

interface Props {
  title: string;
  products: CachedWooProduct[];
  /** How many of the products the row shows; the rest are rendered hidden as spares (components/RelatedProducts). Unset:
   *  every product shows. */
  shown?: number;
}
const { title, products, shown } = Astro.props;
const prevIcon = '<path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" />';
const nextIcon = '<path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" />';
---

{
  products.length > 0 && (
    <section class="product-row product-row--home" data-carousel>
      <div class="product-row__head">
        <h2 class="product-row__title">{title}</h2>
        <div class="product-row__nav">
          {/* aria-disabled, not disabled: a focused arrow that reaches the end keeps keyboard focus */}
          <button class="round-btn" type="button" data-carousel-step="-1" aria-label="Fyrri vörur" aria-disabled="true">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" set:html={prevIcon} />
          </button>
          <button class="round-btn" type="button" data-carousel-step="1" aria-label="Næstu vörur">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" set:html={nextIcon} />
          </button>
        </div>
      </div>
      <div class="product-row__viewport">
        <ul class="product-row__track" data-carousel-track>
          {products.map((p, i) => (
            <li class="product-row__item" hidden={isRowSpare(i, shown)}>
              <ProductCard product={p} variant="tile" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  import '../scripts/carousel';
</script>
