---
// One filter option as live's "Product Filters for WooCommerce" draws it: a square checkbox + label,
// optional (count), and a "+" that expands sub-categories. Each option is a plain link that toggles
// the filter in the URL, so filtering works without JS. variant="size": a button in the Stærð grid — the
// size label on the button, its count only in the accessible name ("42, 125 vörur").
import type { FacetOption } from '../lib/archive';
import { countWord } from '../lib/facets';
import { toggleFilterHref, type FilterKey } from '../lib/liveFilters';

interface Props {
  option: FacetOption;
  groupKey: FilterKey;
  showCounts: boolean;
  basePath: string;
  params: URLSearchParams;
  variant?: 'row' | 'size';
  /** Size grid only: hidden until "Sýna allar stærðir" is opened. */
  minor?: boolean;
}
const { option, groupKey, showCounts, basePath, params, variant = 'row', minor = false } = Astro.props;
const key = option.key ?? groupKey;
const href = toggleFilterHref(basePath, params, key, option.slug);
const hasChildren = option.children.length > 0;
const subId = `filter-${key}-${option.id}`;
const counted = showCounts && option.count != null;
// ArchiveView's in-place updates: the URL key + value this option toggles, and its focus key across swaps.
const fkey = `opt:${key}:${option.slug}`;
// Litur: a colour dot (a two-colour term is split diagonally); the colour name stays the accessible label.
const swatch = option.swatch ? `--swatch-a:${option.swatch[0]};--swatch-b:${option.swatch[1] ?? option.swatch[0]}` : undefined;
---

{
  variant === 'size' ? (
    <li class="filter-size" data-minor={minor ? '' : undefined} data-wide={option.name.length > 6 ? '' : undefined}>
      <a
        class="filter-size__btn"
        href={href}
        role="checkbox"
        aria-checked={option.active ? 'true' : 'false'}
        aria-label={counted ? `${option.name}, ${countWord(option.count ?? 0)}` : undefined}
        rel="nofollow"
        data-op="toggle"
        data-filter-key={key}
        data-filter-value={option.slug}
        data-fkey={fkey}
      >
        {option.name}
      </a>
    </li>
  ) : (
    <li class="filter-option" data-open={option.open ? 'true' : undefined} data-name={option.name}>
      <div class="filter-option__row">
        <a
          class="filter-option__link"
          href={href}
          role="checkbox"
          aria-checked={option.active ? 'true' : 'false'}
          rel="nofollow"
          data-op="toggle"
          data-filter-key={key}
          data-filter-value={option.slug}
          data-fkey={fkey}
        >
          <span class="filter-option__box" aria-hidden="true"></span>
          {swatch && <span class="filter-option__swatch" style={swatch} aria-hidden="true"></span>}
          <span class="filter-option__label">{option.name}{counted && <span class="filter-option__count"> ({option.count})</span>}</span>
        </a>
        {
          hasChildren && (
            <button class="filter-option__toggle" type="button" data-filter-expand data-fkey={`expand:${subId}`} aria-expanded={option.open ? 'true' : 'false'} aria-controls={subId} aria-label={`Sýna undirflokka ${option.name}`}>
              <span aria-hidden="true"></span>
            </button>
          )
        }
      </div>
      {
        hasChildren && (
          <ul class="filter-option__children" id={subId}>
            {option.children.map((child) => (
              <Astro.self option={child} groupKey={groupKey} showCounts={showCounts} basePath={basePath} params={params} />
            ))}
          </ul>
        )
      }
    </li>
  )
}
