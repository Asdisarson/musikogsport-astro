---
// The nike-look product card (SPEC § Wall): a square image on #f5f5f5 with no chrome, then 16px lines: a label line
// (Útsala when on sale), the full title (clamped to two lines in CSS), the first of the product's categories
// (cardCategories), Woo's price with the "-N%" in green after it, and "N litir" when the product comes in several
// colours. On hover or focus the action appears under the price: "Veldu kosti" for variable products, otherwise
// "Frekari upplýsingar" (a link to the product). Stock is never baked here: the label line and the tile's "Uppselt"
// badge are reserved, empty or hidden, and the card script fills them from /api/live/ (see lib/liveCards). A
// buyable simple product's link becomes "Setja í körfu" once that answer comes in.
// variant 'tile' (home carousels): no label or colours line, up to two categories, the "Uppselt" badge on the image.
import type { CachedWooProduct } from '../lib/types';
import { modestCandidate, productImage } from '../lib/img';
import { cardFillFor } from '../lib/photoBgServer';
import { decodeEntities } from '../lib/decode';
import { productPath } from '../lib/paths';
import { formatSaleBadge, salePercent } from '../lib/price';
import { loadCatalogTerms } from '../lib/catalogTerms';
import { cardCategories } from '../lib/categoryTree';
import { cardLabel, colourCount, colourLabel } from '../lib/productCard';
import ProductImage from './ProductImage.astro';
import PriceTag from './PriceTag.astro';

interface Props {
  product: CachedWooProduct;
  eager?: boolean;
  /** 'grid' (the wall) or 'tile' (home carousels). */
  variant?: 'grid' | 'tile';
}
const { product, eager = false, variant = 'grid' } = Astro.props;
const tile = variant === 'tile';
const terms = await loadCatalogTerms();
const img = productImage(product);
// The card draws the WHOLE photo (its CSS and the colour fill assume it), never WordPress' 450px hard crop: the src
// is a modest uncropped candidate of the same srcset (or the original), so a failed candidate falls back to a
// photo of the same shape.
const cardSrc = modestCandidate(img.srcset, img.src);
// The photo's own edge fills the square tile once it's been read (lib/photoBg cardFill); none: the page shows through.
const photoFill = cardFillFor(img.src, img.srcset);
// The rendered image width, from the wall and carousel CSS (measured with the filter rail shown and hidden, since the
// rail is the visitor's choice and `sizes` can't see it, each range takes the wider of the two). Wall cells have a
// 48px gutter each side (96px), a 252px rail column and 16px between images; the frame stops growing at 1800px.
//   >=1800  rail 3-up 468px (hidden 4-up 410)     1400-1799  rail 3-up (100vw - 348px) / 3 - 16px
//   1200-1399  hidden 3-up (100vw - 96px) / 3 - 16px     992-1199  rail 2-up (100vw - 348px) / 2 - 16px
//   <=991  2-up edge to edge, 50vw (a few px over). Home tiles: min(440px, 30.56vw) from 992px, min(300px, 77vw) below.
// The browser picks a ~360–720w candidate instead of the original.
const sizes = tile
  ? '(min-width: 992px) min(440px, 30.56vw), min(300px, 77vw)'
  : '(min-width: 1800px) 468px, (min-width: 1400px) calc((100vw - 348px) / 3 - 16px), (min-width: 1200px) calc((100vw - 96px) / 3 - 16px), (min-width: 992px) calc((100vw - 348px) / 2 - 16px), 50vw';
const fullName = decodeEntities(product.name);
const href = productPath(product.permalink, product.slug);
// The sale is baked from the catalogue price; a sold-out product still shows its sale (stock is filled live).
const percent = product.on_sale ? salePercent(product.price_html) : null;
const cats = cardCategories(
  (product.categories ?? []).map((c) => ({ id: c.id, name: decodeEntities(c.name) })),
  terms.categories,
  tile ? 2 : 1,
);
// The Store API the wall reads has no publish date, so "Nýtt" never shows here (see productCard.ts).
const label = tile ? null : cardLabel({ discounted: percent !== null, outOfStock: false });
const colours = tile ? 0 : colourCount(product.attributes);
// The neutral action: variable products open their choices; everything else is the link to the product. The card
// script swaps a buyable simple product's link for the cart button (liveCards.cardFill).
const actionText = product.type === 'variable' ? 'Veldu kosti' : 'Frekari upplýsingar';
---

<div class:list={['product-card', tile && 'product-card--tile']} data-product-id={product.id} data-product-type={product.type}>
  <a class="product-card__media" href={href} tabindex="-1" aria-hidden="true" {...photoFill}>
    <ProductImage src={cardSrc} srcset={img.srcset} sizes={sizes} alt={img.alt} width={450} height={450} loading={eager ? 'eager' : 'lazy'} />
    {tile && <span class="badge badge--muted" data-card-badge hidden>Uppselt</span>}
  </a>
  <div class="product-card__caption">
    {
      !tile && (
        <span class:list={['product-card__label', 'product-card__label--accent']} data-card-label>
          {label?.text ?? ''}
        </span>
      )
    }
    <h3 class="product-card__title"><a href={href} title={fullName}>{fullName}</a></h3>
    {
      cats.length > 0 && (
        <span class="product-card__cats">
          {cats.map((c, i) => (<>{i > 0 && ', '}<a href={c.path}>{c.name}</a></>))}
        </span>
      )
    }
    <div class="product-card__after">
      <div class="product-card__price">
        <PriceTag product={product} />
        {percent !== null && <span class="product-card__off">{formatSaleBadge(percent)}</span>}
      </div>
      {colours > 0 && <span class="product-card__colours">{colourLabel(colours)}</span>}
      <div class="product-card__action">
        <a href={href} aria-label={`${actionText}: ${fullName}`}>{actionText}</a>
      </div>
    </div>
  </div>
</div>

<script>
  // Fills every product card on the page from ONE /api/live/ call per chunk of ids (no store, so stock is current).
  // Pure decisions live in lib/liveCards; this part only applies them. Cards are marked seen when collected, so a
  // page view never asks twice; a failed call unmarks its cards (they stay neutral and are asked again later).
  // Re-runs on: cards added to the page (MutationObserver: archive swaps, the related-products island), bfcache
  // restore and tab return (stock may have changed, so everything is asked again). A failed call keeps the last
  // answer it had (that was a real WooCommerce answer; add-to-cart and the PDP check stock again) and is asked once
  // more after a few seconds (lib/liveCards LIVE_RETRY_MS). Each call is numbered; a card takes an answer only from
  // a call at least as new as the one that filled it, so a slow older response can't overwrite a newer one.
  import { addToCart, openCart } from '../lib/cartStore';
  import { chunkIds, LIVE_MAX_IDS, priceChanged } from '../lib/livePrices';
  import { cardFill, LIVE_RETRY_MS, LIVE_TIMEOUT_MS, parseLiveAnswer, shouldRetry, takesAnswer, type CardFill } from '../lib/liveCards';
  import { relatedVisible } from '../lib/relatedPicks';
  import { formatSaleBadge } from '../lib/price';
  import { onPageRestored, onTabVisible } from '../lib/pageLifecycle';

  // "Setja í körfu" on a card: WooCommerce's ajax add to cart, then the side cart opens (as on the PDP).
  // The cart store runs cart calls one at a time, so quick adds on several cards can't lose an item.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLButtonElement>('[data-card-add]');
    if (!btn || btn.disabled) return;
    btn.disabled = true;
    try {
      await addToCart(Number(btn.dataset.cardAdd), 1);
    } catch {
      /* the side cart shows cartError */
    } finally {
      btn.disabled = false;
      openCart();
    }
  });

  let seen = new WeakSet<HTMLElement>();
  let timer = 0;
  let calls = 0;
  let retries = 0;
  let retryTimer = 0;
  const filledBy = new WeakMap<HTMLElement, number>();

  function schedule(): void {
    if (timer) return; // one pass per tick: a swap that adds many cards makes one call
    timer = window.setTimeout(() => {
      timer = 0;
      void run();
    }, 0);
  }

  async function run(): Promise<void> {
    const seq = ++calls;
    let failed = false;
    const byId = new Map<number, HTMLElement[]>();
    for (const card of document.querySelectorAll<HTMLElement>('[data-product-id]')) {
      if (seen.has(card)) continue;
      const id = Number(card.dataset.productId);
      if (!Number.isInteger(id) || id <= 0) continue;
      seen.add(card);
      byId.set(id, [...(byId.get(id) ?? []), card]);
    }
    for (const group of chunkIds([...byId.keys()], LIVE_MAX_IDS)) {
      const cards = group.flatMap((id) => byId.get(id) ?? []);
      try {
        // A hung call fails after LIVE_TIMEOUT_MS: the cards keep their neutral state, the related rows settle, and a retry follows.
        const res = await fetch(`/api/live/?ids=${group.join(',')}`, { cache: 'no-store', headers: { accept: 'application/json' }, signal: AbortSignal.timeout(LIVE_TIMEOUT_MS) });
        if (!res.ok) throw new Error(`live ${res.status}`);
        const answer = parseLiveAnswer(await res.json());
        for (const card of cards) {
          if (!takesAnswer(filledBy.get(card), seq)) continue; // a newer call already filled this card
          const live = answer.get(Number(card.dataset.productId));
          const fill = cardFill(card.dataset.productType ?? '', bakedPrice(card), live);
          if (!fill) continue;
          filledBy.set(card, seq);
          // The last stock answer the card had, for settleRelated (a card never answered carries none).
          if (live?.stock) card.dataset.stock = live.stock;
          apply(card, fill);
        }
      } catch {
        // Unmark so the retry asks again; a card keeps its last answer (or stays neutral if it never had one).
        failed = true;
        for (const card of cards) seen.delete(card);
      }
    }
    settleRelated();
    if (failed) retryLater();
    else retries = 0;
  }

  /** The related rows (components/RelatedProducts): the first `limit` candidates the live answer does not name sold out
   *  show, in row order, and the rest stay hidden, so a sold-out product's place goes to the next spare. Worked out from
   *  scratch on every pass (lib/relatedPicks relatedVisible), so a restock brings a product back. A candidate with no
   *  answer counts as available: before the answer the row shows as the server rendered it. A row with nothing left
   *  to show is hidden as a whole. Tiles are hidden through their list item, which has no display of its own. */
  function settleRelated(): void {
    for (const row of document.querySelectorAll<HTMLElement>('[data-related-limit]')) {
      const limit = Number(row.dataset.relatedLimit);
      if (!Number.isInteger(limit) || limit <= 0) continue;
      const cards = [...row.querySelectorAll<HTMLElement>('[data-product-id]')];
      const ids = cards.map((card) => Number(card.dataset.productId));
      const soldOut = new Set(cards.filter((card) => card.dataset.stock === 'outofstock').map((card) => Number(card.dataset.productId)));
      const shown = new Set(relatedVisible(ids, soldOut, limit));
      cards.forEach((card, i) => {
        const item = card.closest<HTMLElement>('.product-row__item') ?? card;
        item.hidden = !shown.has(ids[i]);
      });
      row.hidden = shown.size === 0;
    }
  }

  function retryLater(): void {
    if (retryTimer || !shouldRetry(retries)) return;
    retries++;
    retryTimer = window.setTimeout(() => {
      retryTimer = 0;
      schedule();
    }, LIVE_RETRY_MS);
  }

  /** The price markup the server baked, remembered on first sight so a reverted price can go back to it. */
  function bakedPrice(card: HTMLElement): string {
    const wrap = card.querySelector<HTMLElement>('.product-card__price');
    if (!wrap) return '';
    if (wrap.dataset.bakedPrice === undefined) wrap.dataset.bakedPrice = wrap.querySelector('.price')?.innerHTML ?? '';
    return wrap.dataset.bakedPrice;
  }

  function apply(card: HTMLElement, fill: CardFill): void {
    const label = card.querySelector<HTMLElement>('[data-card-label]');
    if (label && fill.label !== null && label.textContent !== fill.label) label.textContent = fill.label;
    const badge = card.querySelector<HTMLElement>('[data-card-badge]');
    if (badge) badge.hidden = !fill.outOfStock;
    const wrap = card.querySelector<HTMLElement>('.product-card__price');
    if (wrap) {
      const price = wrap.querySelector<HTMLElement>('.price');
      // fill.priceHtml is WooCommerce's price_html after lib/sanitize (server side, in livePrices.liveProductOf). It is
      // parsed as a fragment and put in place of the old children: the only markup source is that sanitised answer.
      if (price && priceChanged(price.innerHTML, fill.priceHtml)) {
        price.replaceChildren(document.createRange().createContextualFragment(fill.priceHtml));
      }
      setOff(wrap, fill.percent);
    }
    setAction(card, fill);
  }

  function setOff(wrap: HTMLElement, percent: number | null): void {
    const off = wrap.querySelector<HTMLElement>('.product-card__off');
    if (percent === null) {
      off?.remove();
      return;
    }
    const text = formatSaleBadge(percent);
    if (off) {
      if (off.textContent !== text) off.textContent = text;
      return;
    }
    const span = document.createElement('span');
    span.className = 'product-card__off';
    span.textContent = text;
    wrap.append(span);
  }

  function setAction(card: HTMLElement, fill: CardFill): void {
    const box = card.querySelector<HTMLElement>('.product-card__action');
    if (!box) return;
    const title = card.querySelector<HTMLAnchorElement>('.product-card__title a');
    const name = title?.textContent?.trim() ?? '';
    const isButton = box.querySelector('[data-card-add]') !== null;
    const label = `${fill.action.text}: ${name}`;
    if (fill.action.kind === 'cart') {
      if (isButton) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.cardAdd = card.dataset.productId ?? '';
      btn.textContent = fill.action.text;
      btn.setAttribute('aria-label', label);
      box.replaceChildren(btn);
      return;
    }
    // Back to the neutral link (a product that went out of stock, or one that was never buyable).
    if (!isButton) return;
    const link = document.createElement('a');
    link.href = title?.getAttribute('href') ?? '#';
    link.textContent = fill.action.text;
    link.setAttribute('aria-label', label);
    box.replaceChildren(link);
  }

  schedule();
  new MutationObserver((records) => {
    if (records.some((r) => r.addedNodes.length > 0)) schedule();
  }).observe(document.body, { childList: true, subtree: true });
  onPageRestored(() => {
    seen = new WeakSet();
    retries = 0;
    schedule();
  });
  onTabVisible(() => {
    seen = new WeakSet();
    retries = 0;
    schedule();
  });
</script>
