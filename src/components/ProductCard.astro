---
import type { WooProduct } from '../lib/types';
import { productImage } from '../lib/img';
import { splitBrand } from '../lib/brand';
import ProductImage from './ProductImage.astro';
import PriceTag from './PriceTag.astro';
import Icon from './Icon.astro';

interface Props {
  product: WooProduct;
  eager?: boolean;
}
const { product, eager = false } = Astro.props;
const img = productImage(product);
const out = product.stock_status === 'outofstock';
const { brand, rest } = splitBrand(product.name);
---

<a class="product-card" href={`/vara/${product.slug}`}>
  <div class="product-card__media">
    <ProductImage src={img.src} alt={img.alt} loading={eager ? 'eager' : 'lazy'} />
    {out && <span class="badge badge--muted">Uppselt</span>}
    {!out && product.on_sale && <span class="badge badge--sale">Tilboð</span>}
    <div class="product-card__quick">
      <span class="pill">Skoða <Icon name="arrow-up-right" /></span>
    </div>
  </div>
  <div class="product-card__body">
    {brand && <span class="product-card__brand">{brand}</span>}
    <h3 class="product-card__title">{rest}</h3>
    <PriceTag product={product} />
  </div>
</a>
