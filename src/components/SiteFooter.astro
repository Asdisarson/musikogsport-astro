---
// Black footer: a brand column (the footer logo on a white tile, a line about the shop, the opening hours from the
// campaign bar's text linking to /opnunartimi/, Instagram), then four link columns (shop sections from the main menu,
// the WordPress footer menu as "Hjálp", "Um okkur", and the store's contact details with icons), then a full-width
// orange bottom bar with the company line and legal links (the inner div keeps its content on the page grid while
// the bar's background runs edge to edge).
// On phones each column is a <details> accordion: open by default (so it works without JS), closed by the
// script below under 992px and kept open above it.
import Icon from './Icon.astro';
import type { SiteChrome } from '../lib/siteChrome';
import { linkRel } from '../lib/safeUrl';

interface Props {
  chrome: SiteChrome;
}
const { chrome } = Astro.props;
const f = chrome.footer;
const addressLines = f.address.split(/\r?\n/).filter(Boolean);
const tel = f.phone.replace(/[^\d+]/g, '');
// Top-level shop sections; an item pointing at the home page ("Vörumerki") is only a menu heading.
const shop = chrome.primary.filter((i) => i.href && i.href !== '/');
const about = [
  { title: 'Um okkur', href: '/um-okkur/' },
  { title: 'Instagram', href: 'https://www.instagram.com/musikogsport/', external: true },
];
const logo = chrome.logos.footer ?? { url: '/logo-footer.webp', width: 720, height: 452, alt: 'Músík og Sport' };
// The campaign bar's right-hand text is the hours ("Opið virka daga 10-18 & laugardaga 10-16") — unless the owner has
// put something else there, which isn't shown as hours.
const hours = [chrome.campaign.textRight, chrome.campaign.text].find((t) => /^\s*opi[ðd]/i.test(t ?? ''));
const legal = [
  { title: 'Skilmálar', href: '/skilmalar/' },
  { title: 'Persónuvernd', href: '/personuvernd/' },
];
---

<footer class="site-footer">
  <div class="site-footer__cols">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="/" aria-label="Músík og Sport — forsíða">
        <img src={logo.url} alt={logo.alt} width={logo.width} height={logo.height} loading="lazy" decoding="async" />
      </a>
      <p class="site-footer__about">Íþróttavörur frá fagfólki í yfir 30 ár.</p>
      {
        hours && (
          <a class="site-footer__hours" href="/opnunartimi/">
            <Icon name="clock" size={18} stroke-width={1.5} />
            <span>{hours}</span>
          </a>
        )
      }
      <a class="site-footer__social" href="https://www.instagram.com/musikogsport/" target="_blank" rel="noopener" aria-label="Músík og Sport á Instagram">
        <Icon name="instagram" size={20} stroke-width={1.5} />
      </a>
    </div>

    {
      shop.length > 0 && (
        <details class="site-footer__group" open data-footer-group>
          <summary class="site-footer__title">Verslun<Icon name="chevron-down" stroke-width={1.5} /></summary>
          <ul class="site-footer__menu">
            {shop.map((item) => (<li><a href={item.href} target={item.target || undefined} rel={linkRel(item.target, item.external)}>{item.title}</a></li>))}
          </ul>
        </details>
      )
    }

    {
      chrome.footerMenu.length > 0 && (
        <details class="site-footer__group" open data-footer-group>
          <summary class="site-footer__title">Hjálp<Icon name="chevron-down" stroke-width={1.5} /></summary>
          <ul class="site-footer__menu">
            {chrome.footerMenu.map((item) => (<li><a href={item.href} target={item.target || undefined} rel={linkRel(item.target, item.external)}>{item.title}</a></li>))}
          </ul>
        </details>
      )
    }

    <details class="site-footer__group" open data-footer-group>
      <summary class="site-footer__title">Um okkur<Icon name="chevron-down" stroke-width={1.5} /></summary>
      <ul class="site-footer__menu">
        {about.map((item) => (<li><a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>{item.title}</a></li>))}
      </ul>
    </details>

    <details class="site-footer__group" open data-footer-group>
      <summary class="site-footer__title">Hafðu samband<Icon name="chevron-down" stroke-width={1.5} /></summary>
      <ul class="site-footer__menu site-footer__contact">
        <li>
          <Icon name="pin" size={18} stroke-width={1.5} />
          <span>
            {addressLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
            {f.directionsHref && (<><br /><a href={f.directionsHref} target="_blank" rel="noopener">{f.directionsLabel}</a></>)}
          </span>
        </li>
        <li><Icon name="mail" size={18} stroke-width={1.5} /><a href={`mailto:${f.email}`}>{f.email}</a></li>
        <li><Icon name="phone" size={18} stroke-width={1.5} /><a href={`tel:${tel}`}>{f.phone}</a></li>
      </ul>
    </details>
  </div>

  <div class="site-footer__bar">
    <div class="site-footer__bar-inner">
      <p class="site-footer__where"><Icon name="pin" size={16} stroke-width={1.5} /> Ísland</p>
      <p class="site-footer__company">{f.companyLine}</p>
      <ul class="site-footer__legal">
        {legal.map((item) => (<li><a href={item.href}>{item.title}</a></li>))}
      </ul>
    </div>
  </div>
</footer>

<script>
  // Desktop: every group stays open (its summary is a plain heading). Phones: accordions, closed at first.
  const desktop = window.matchMedia('(min-width: 992px)');
  const groups = document.querySelectorAll<HTMLDetailsElement>('[data-footer-group]');
  const sync = () =>
    groups.forEach((d) => {
      d.open = desktop.matches;
      const summary = d.querySelector('summary');
      if (summary) summary.tabIndex = desktop.matches ? -1 : 0;   // a heading on desktop, not a tab stop
    });
  groups.forEach((d) =>
    d.querySelector('summary')?.addEventListener('click', (e) => {
      if (desktop.matches) e.preventDefault();
    }),
  );
  desktop.addEventListener('change', sync);
  sync();
</script>
