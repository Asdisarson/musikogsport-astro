---
// The 60px sticky main bar: logo left, the WordPress menu centred (each parent opens a full-width mega-menu
// panel), search pill + wishlist + cart right. Below 992px: logo, then search, account, cart and the menu
// drawer toggle as 44px icon buttons.
import CartButton from './CartButton.tsx';
import Icon from './Icon.astro';
import NavItem from './NavItem.astro';
import type { SiteChrome } from '../lib/siteChrome';

interface Props {
  chrome: SiteChrome;
}
const { chrome } = Astro.props;
const logo = chrome.logos.header ?? { url: '/logo-header.webp', width: 262, height: 80, alt: 'Músík og Sport' };
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Músík og Sport — forsíða">
      <img src={logo.url} alt={logo.alt || 'Músík og Sport'} width={logo.width} height={logo.height} />
    </a>

    <nav class="main-nav" aria-label="Aðalvalmynd" data-main-nav>
      <ul class="main-nav__list">
        {chrome.primary.map((item) => <NavItem item={item} depth={0} />)}
      </ul>
    </nav>

    <div class="site-header__right">
      <button class="search-pill" type="button" data-search-open aria-controls="search-overlay" aria-label="Leita í vörum">
        <Icon name="search" stroke-width={1.5} />
        <span aria-hidden="true">Leita</span>
      </button>
      <button class="icon-btn site-header__search" type="button" data-search-open aria-controls="search-overlay" aria-label="Leita í vörum">
        <Icon name="search" stroke-width={1.5} />
      </button>
      <a class="icon-btn site-header__wish" href="/oskalisti/" aria-label="Óskalisti">
        <Icon name="heart" stroke-width={1.5} />
        <span class="icon-count" data-wish-count></span>
      </a>
      <a class="icon-btn site-header__account" href="/min-sida/" data-login-link>
        <Icon name="user" stroke-width={1.5} />
        <span class="visually-hidden" data-login-label>Innskráning</span>
      </a>
      <CartButton client:load />
      <noscript><a class="icon-btn cart-link" href="/karfa/" aria-label="Karfa"><Icon name="bag" stroke-width={1.5} /></a></noscript>
      <button
        class="icon-btn site-header__toggle"
        type="button"
        data-menu-open
        aria-controls="side-menu"
        aria-expanded="false"
        aria-label="Valmynd"
      >
        <Icon name="menu" stroke-width={1.5} />
      </button>
    </div>
  </div>
</header>
