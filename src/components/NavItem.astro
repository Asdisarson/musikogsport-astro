---
// One menu item. Depth 0: a top-level link in the main bar and, when it has children, its full-width
// mega-menu panel (lib/megaMenu decides grouped columns vs one flowed list). It opens on hover or keyboard
// focus; Escape closes it (Base.astro). Deeper items render as plain nested lists inside their column.
import { megaPanel } from '../lib/megaMenu';
import type { MenuItem } from '../lib/siteChrome';
import { isCurrentMenuHref } from '../lib/paths';
import { linkRel } from '../lib/safeUrl';

interface Props {
  item: MenuItem;
  depth: number;
}
const { item, depth } = Astro.props;
const isCurrent = isCurrentMenuHref(item.href, Astro.url);
const panel = depth === 0 ? megaPanel(item) : null;
// A column heading pointing nowhere ('#') or at the home page (a WordPress menu heading like "Vörumerki") is a
// plain heading, not a link, as the footer treats those items.
const headLinks = (href?: string) => Boolean(href) && href !== '/' && href !== '#';
const linkAttrs = {
  href: item.href,
  target: item.target || undefined,
  rel: linkRel(item.target, item.external),
  'aria-current': isCurrent ? ('page' as const) : undefined,
};
---

{
  depth === 0 ? (
    <li class:list={['nav-item', 'nav-item--top', panel && 'nav-item--parent']}>
      <a class="nav-item__link" {...linkAttrs}>
        {item.title}
      </a>
      {panel && (
        <div class="mega">
          <div class="mega__grid" style={`--cols: ${panel.columns}`}>
            {panel.kind === 'grouped' ? (
              panel.groups.map((g) => (
                <div class="mega__col">
                  {headLinks(g.href) ? (
                    <a class="mega__head" href={g.href} target={g.target || undefined} rel={linkRel(g.target)}>
                      {g.title}
                    </a>
                  ) : (
                    <span class="mega__head">{g.title}</span>
                  )}
                  {g.links.length > 0 && (
                    <ul class="mega__list">
                      {g.links.map((l) => (
                        <Astro.self item={l} depth={2} />
                      ))}
                    </ul>
                  )}
                </div>
              ))
            ) : (
              <div class="mega__col mega__col--flow" style={`--flow: ${panel.flow}`}>
                {headLinks(panel.href) ? (
                  <a class="mega__head" href={panel.href} target={panel.target || undefined} rel={linkRel(panel.target)}>
                    {panel.title}
                  </a>
                ) : (
                  <span class="mega__head">{panel.title}</span>
                )}
                <ul class="mega__list">
                  {panel.links.map((l) => (
                    <Astro.self item={l} depth={1} />
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      )}
    </li>
  ) : (
    <li class="mega__item">
      <a class="mega__link" {...linkAttrs}>
        {item.title}
      </a>
      {item.children.length > 0 && (
        <ul class="mega__sub">
          {item.children.map((child) => (
            <Astro.self item={child} depth={depth + 1} />
          ))}
        </ul>
      )}
    </li>
  )
}
