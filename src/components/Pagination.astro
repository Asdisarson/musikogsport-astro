---
// The wall's numbered pages (ArchiveView, under the grid): previous / next as the carousels' round arrows, the first,
// last and neighbouring page numbers, "…" for the rest. Plain links: no JS needed, and crawlable.
interface Props {
  page: number;
  totalPages: number;
  /** Build the href for a given page number (preserves existing query params). */
  hrefFor: (page: number) => string;
}
const { page, totalPages, hrefFor } = Astro.props;

function pageList(cur: number, total: number): (number | '…')[] {
  const keep = new Set<number>([1, total]);
  for (let i = cur - 1; i <= cur + 1; i++) if (i >= 1 && i <= total) keep.add(i);
  const sorted = [...keep].sort((a, b) => a - b);
  const out: (number | '…')[] = [];
  let prev = 0;
  for (const n of sorted) {
    if (prev && n - prev > 1) out.push('…');
    out.push(n);
    prev = n;
  }
  return out;
}

const items = totalPages > 1 ? pageList(page, totalPages) : [];
const prevIcon = '<path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" />';
const nextIcon = '<path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" />';
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Síður">
      {page > 1 ? (
        <a class="round-btn round-btn--prev" href={hrefFor(page - 1)} rel="prev" aria-label="Fyrri síða">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" set:html={prevIcon} />
        </a>
      ) : (
        <span class="round-btn round-btn--prev" aria-disabled="true" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" set:html={prevIcon} />
        </span>
      )}
      {items.map((it) =>
        it === '…' ? (
          <span class="gap" aria-hidden="true">…</span>
        ) : it === page ? (
          <span class="pagination__page is-current" aria-current="page">{it}</span>
        ) : (
          <a class="pagination__page" href={hrefFor(it)} aria-label={`Síða ${it}`}>{it}</a>
        ),
      )}
      {page < totalPages ? (
        <a class="round-btn round-btn--next" href={hrefFor(page + 1)} rel="next" aria-label="Næsta síða">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" set:html={nextIcon} />
        </a>
      ) : (
        <span class="round-btn round-btn--next" aria-disabled="true" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" set:html={nextIcon} />
        </span>
      )}
    </nav>
  )
}
