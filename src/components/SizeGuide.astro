---
// Live's size chart popup: any `[data-sizeguide]` link (the product page puts "Stærðartafla" beside "Veldu stærð",
// inside the purchase island) opens it, and it lazily lifts the charts of /staerdir/ (the WordPress page). The link's
// data-sizeguide-want (lib/sizeGuide) picks the charts for the product's Kyn and clothing type, shown as tabs; the
// plain link is the no-JS fallback, and "Sjá allar stærðartöflur" opens the whole page. Clicks are caught on the
// document, so the island's hydration can't drop the listener.
//
// The charts are drawn by lib/sizeGuideView, which the /staerdir/ page uses too, so the two look the same: each
// WordPress table wide (sizes across) where it fits and sideways where it doesn't. Phones get a bottom sheet. A size
// already chosen in the picker is highlighted in both layouts.
---

<dialog class="popup sizeguide" data-sizeguide-dialog aria-labelledby="sizeguide-title">
  <div class="sizeguide__head">
    <span class="sizeguide__grab" aria-hidden="true"></span>
    <button class="popup__close" type="button" data-popup-close aria-label="Loka">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    <h4 class="popup__title" id="sizeguide-title">Stærðartafla</h4>
    <p class="sizeguide__chosen" data-sizeguide-chosen hidden></p>
    <div class="sizeguide__tabs" role="tablist" aria-label="Stærðartöflur" data-sizeguide-tabs hidden></div>
  </div>
  <div class="sizeguide__body" data-sizeguide-body><p class="sizeguide__status">Sæki stærðartöflu…</p></div>
  <p class="sizeguide__all"><a href="/staerdir/">Sjá allar stærðartöflur</a></p>
</dialog>

<script>
  import { parseWant, pickSections } from '../lib/sizeGuide';
  import { mountSizeGuide, splitSections, type Section } from '../lib/sizeGuideView';

  const dialog = document.querySelector<HTMLDialogElement>('[data-sizeguide-dialog]');
  const tabs = dialog?.querySelector<HTMLElement>('[data-sizeguide-tabs]');
  const body = dialog?.querySelector<HTMLElement>('[data-sizeguide-body]');
  const chosenNote = dialog?.querySelector<HTMLElement>('[data-sizeguide-chosen]');
  const view = tabs && body ? mountSizeGuide(tabs, body) : null;
  let sections: Promise<Section[]> | null = null;

  async function loadSections(href: string): Promise<Section[]> {
    // a hung request opens the size page itself (the caller's catch) instead of leaving "Sæki stærðartöflu…"
    const res = await fetch(href, { headers: { Accept: 'text/html' }, signal: AbortSignal.timeout(10000) });
    if (!res.ok) throw new Error(String(res.status));
    const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
    const content = doc.querySelector('.wp-page');
    const found = content ? splitSections(content) : [];
    if (!found.length) throw new Error('no charts');
    return found;
  }

  function render(all: Section[], picked: number[], chosen: string) {
    if (!view || !chosenNote) throw new Error('size chart markup missing');
    chosenNote.hidden = !chosen;
    chosenNote.textContent = chosen ? `Valin stærð: ${chosen}` : '';
    view.render(picked.map((i) => all[i]), chosen);
  }

  document.addEventListener('click', async (e) => {
    const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-sizeguide]');
    if (!link) return;
    if (!dialog || !tabs || !body) return; // no popup on this page: the plain link opens /staerdir/
    e.preventDefault();
    dialog.showModal();
    // the size already picked beside this link, to highlight in the charts
    const swatch = link.closest('.pdp-var')?.querySelector('.pdp-swatch[aria-checked="true"]');
    // a photo swatch has no text: its name is the button's aria-label
    const chosen = (swatch?.textContent?.trim() || swatch?.getAttribute('aria-label')?.trim()) ?? '';
    try {
      sections ??= loadSections(link.href).catch((err) => {
        sections = null; // a later open tries again
        throw err;
      });
      const all = await sections;
      const want = parseWant(link.dataset.sizeguideWant);
      render(all, want ? pickSections(all.map((s) => s.heading), want) : all.map((_, i) => i), chosen);
    } catch {
      window.location.href = link.href;
    }
  });

  dialog?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === dialog || t.closest('[data-popup-close]')) dialog.close();
  });
</script>
