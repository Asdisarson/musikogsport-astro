---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<!-- no `container` here: all call sites already wrap this, and self-applying it clamps the
     trail to --maxw inside a --maxw-wide parent, indenting it ~100px past the content below. -->
<nav class="breadcrumbs" aria-label="Slóð">
  <ol>
    {
      items.map((c) => (
        <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>
      ))
    }
  </ol>
</nav>
