---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs container" aria-label="Brauðmolar">
  <ol>
    {
      items.map((c) => (
        <li>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</li>
      ))
    }
  </ol>
</nav>
