---
// Price exactly as live renders it: WooCommerce's own price_html (Icelandic formatting, sale
// del/ins, variable ranges). Formatted-number fallback only when price_html is missing.
import type { WooProduct } from '../lib/types';
import { formatISK } from '../lib/format';
import { sanitizeHtml } from '../lib/sanitize';

interface Props {
  product: Pick<WooProduct, 'type' | 'price' | 'regular_price' | 'sale_price' | 'on_sale' | 'price_html'>;
  class?: string;
}
const { product, class: className = '' } = Astro.props;
const html = product.price_html ? sanitizeHtml(product.price_html) : '';
const onSale = Boolean(product.on_sale) && product.sale_price !== '' && product.regular_price !== '';
---

{
  html ? (
    <span class={`price ${className}`} set:html={html} />
  ) : onSale ? (
    <span class={`price ${className}`}>
      <del>{formatISK(product.regular_price)}</del>
      <ins>{formatISK(product.sale_price)}</ins>
    </span>
  ) : product.price !== '' ? (
    <span class={`price ${className}`}>{formatISK(product.price)}</span>
  ) : null
}
