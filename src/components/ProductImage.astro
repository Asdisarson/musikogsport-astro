---
import { mediaUrl, PLACEHOLDER } from '../lib/img';

interface Props {
  src?: string | null;
  alt?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  id?: string;
  /** Already rewritten to the media host (mediaSrcset); with `sizes`. */
  srcset?: string;
  sizes?: string;
}
const { src, alt = '', width, height, loading = 'lazy', class: className, id, srcset, sizes } = Astro.props;
const finalSrc = mediaUrl(src) || PLACEHOLDER;
// Most local media files 404: `data-fallback` opts the image into /img-fallback.js (loaded by Base.astro), which drops
// a failed srcset, then swaps a failed src for the placeholder, once. No inline onerror: an enforced CSP blocks it.
---

<img
  src={finalSrc}
  srcset={srcset || undefined}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  class={className}
  id={id}
  data-fallback
/>
