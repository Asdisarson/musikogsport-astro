---
interface Props {
  total: number;
  sort?: string;
  onSale?: boolean;
  inStock?: boolean;
  showSaleFilter?: boolean;
}
const { total, sort = 'date', onSale = false, inStock = false, showSaleFilter = true } = Astro.props;

const options: [string, string][] = [
  ['date', 'Nýjast'],
  ['popularity', 'Vinsælast'],
  ['price-asc', 'Verð: lágt → hátt'],
  ['price-desc', 'Verð: hátt → lágt'],
  ['title', 'Heiti A–Ö'],
];
---

<div class="toolbar container">
  <span class="toolbar__count">{total.toLocaleString('is-IS')} vörur</span>
  <form method="get">
    {
      showSaleFilter && (
        <label>
          <input type="checkbox" name="on_sale" value="true" checked={onSale} /> Á útsölu
        </label>
      )
    }
    <label>
      <input type="checkbox" name="instock" value="true" checked={inStock} /> Til á lager
    </label>
    <label>
      Raða:
      <select name="sort" onchange="this.form.submit()">
        {options.map(([v, l]) => (<option value={v} selected={sort === v}>{l}</option>))}
      </select>
    </label>
    <button class="btn" type="submit">Sía</button>
  </form>
</div>
